# Optional non-sensitive frontend build/runtime variables.
# A static frontend can deploy without an API; set this when API features are
# enabled. The frontend stack does not create or require the backend stack.
AWS_REGION=ap-southeast-1
API_BASE_URL=https://api.example.test
FRONTEND_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/replace-me
