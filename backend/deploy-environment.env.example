# Copy this file outside the repository before adding real values.
# The bootstrap script accepts simple KEY=VALUE lines only; do not use
# `export`, shell interpolation, or multiline values.

# Required by the Caddy reverse proxy.
ACME_EMAIL=operator@example.com
APPLICATION_API_HOSTNAME=api.staging.example.test

# Allow the deployed frontend to call the API and any WebSocket endpoint.
APPLICATION_ALLOWED_ORIGINS=https://app.staging.example.test

# Pin the proxy and application images to reviewed versions before applying.
CADDY_IMAGE=caddy:REPLACE_WITH_REVIEWED_VERSION

# Add consumer-specific runtime settings here. Names ending in API_KEY, TOKEN,
# PASSWORD, SECRET, or PRIVATE_KEY are stored as SSM SecureString values.
