#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(cd -- "${script_directory}/.." && pwd)"
site_directory="${repository_root}/site"
docs_command=""

usage() {
  cat <<'EOF'
Usage: bin/docs <command> [options]

Commands:
  build [--strict]  Build the documentation site into site/
  lint              Run Vale, Markdownlint, and offline Lychee
  serve             Serve a local documentation preview
  clean             Remove generated documentation output
EOF
}

die() {
  echo "bin/docs: $*" >&2
  exit 2
}

select_builder() {
  if [[ -x "${repository_root}/.venv-docs/bin/zensical" ]]; then
    docs_command="${repository_root}/.venv-docs/bin/zensical"
  elif command -v zensical >/dev/null 2>&1; then
    docs_command="$(command -v zensical)"
  else
    die "zensical is required; install requirements-docs.txt in .venv-docs"
  fi
}

require_project() {
  [[ -f "${repository_root}/mkdocs.yml" ]] || die "mkdocs.yml is missing"
  [[ -d "${repository_root}/docs/mkdocs" ]] || die "docs/mkdocs/ is missing"
}

build() {
  local strict=false
  while (($# > 0)); do
    case "$1" in
      --strict) strict=true ;;
      *) die "unknown build option: $1" ;;
    esac
    shift
  done

  select_builder
  require_project
  mkdir -p "${site_directory}"

  local -a options=(build --config-file "${repository_root}/mkdocs.yml")
  if [[ "${strict}" == true ]]; then
    options+=(--strict)
  fi
  "${docs_command}" "${options[@]}"
}

find_tool() {
  local cached_path="$1" command_name="$2"
  if [[ -x "$cached_path" ]]; then
    printf '%s\n' "$cached_path"
  elif command -v "$command_name" >/dev/null 2>&1; then
    command -v "$command_name"
  else
    die "$command_name is required; install the documentation lint tools or restore .docs-tools"
  fi
}

lint() {
  (($# == 0)) || die "lint does not accept options"
  require_project

  local tool_directory="${repository_root}/.docs-tools"
  local vale_command markdownlint_command lychee_command
  vale_command="$(find_tool "${tool_directory}/bin/vale" vale)"
  markdownlint_command="$(find_tool "${tool_directory}/node_modules/.bin/markdownlint-cli2" markdownlint-cli2)"
  lychee_command="$(find_tool "${tool_directory}/bin/lychee" lychee)"

  cd "${repository_root}"
  "${vale_command}" docs/mkdocs README.md CHANGELOG.md
  "${markdownlint_command}" 'docs/mkdocs/**/*.md' README.md CHANGELOG.md
  "${lychee_command}" --offline 'docs/mkdocs/**/*.md'
}

serve() {
  select_builder
  require_project
  cd "${repository_root}"
  exec "${docs_command}" serve --config-file "${repository_root}/mkdocs.yml"
}

clean() {
  if [[ -d "${site_directory}" ]]; then
    find "${site_directory}" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    rmdir "${site_directory}" 2>/dev/null || true
  fi
}

main() {
  [[ $# -gt 0 ]] || { usage >&2; exit 2; }
  case "$1" in
    build) shift; build "$@" ;;
    lint) shift; lint "$@" ;;
    serve) shift; (($# == 0)) || die "serve does not accept options"; serve ;;
    clean) shift; (($# == 0)) || die "clean does not accept options"; clean ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $1" ;;
  esac
}

main "$@"
