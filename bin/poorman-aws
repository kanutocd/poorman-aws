EOF
  )"
  frontend_rollback="$(cat <<'EOF'
name: Roll back `poorman-aws` frontend
on:
  # Keep rollback manual by default. A future workflow_run trigger must
  # supply a reviewed consumer_ref and explicit rollback confirmation:
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
  workflow_dispatch:
    inputs:
      environment:
        required: true
        default: __TARGET_ENVIRONMENT__
        type: choice
