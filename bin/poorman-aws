      environment: ${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}
      aws_region: __REGION__
      frontend_directory: __FRONTEND_DIRECTORY__
      build_command: __FRONTEND_BUILD_COMMAND__
      deploy_command: __FRONTEND_DEPLOY_COMMAND__
      frontend_hostname: ${{ vars.FRONTEND_HOSTNAME || '__FRONTEND_HOSTNAME__' }}
      output_entrypoint: __FRONTEND_OUTPUT_ENTRYPOINT__
      frontend_url: ${{ vars.FRONTEND_URL || '__FRONTEND_URL__' }}
      api_url: ${{ vars.API_URL || '__API_URL__' }}
      frontend_origin: ${{ vars.FRONTEND_ORIGIN || '__FRONTEND_ORIGIN__' }}
      api_base_url: ${{ vars.API_BASE_URL || '__API_BASE_URL__' }}
      frontend_certificate_arn: ${{ vars.FRONTEND_CERTIFICATE_ARN || '__FRONTEND_CERTIFICATE_ARN__' }}
