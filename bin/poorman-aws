#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Self-contained consumer entry point. It is intentionally safe:
# operational commands are reserved until their adapters are implemented.

declare -A values sources cli_values
config_path=''
config_explicit=false
json_output=false
non_interactive=false
dry_run=false
overwrite=false
offline=false
check_aws=false
check_docker=false
check_infra=false
check_ami=false
check_github=false
command_name=''
command_args=()
command_environment=''
command_apply=false
command_confirm=''
command_repo=''
command_release_id=''
command_action=''
command_subnet_id=''
command_ssh_cidr=''
command_ami_name_prefix=''
command_wait=false
command_env_file=''
command_clear_parameter=''
command_non_secret_parameters=()
command_allow_type_change=false
command_supplemental_files=()

usage() {
  cat <<'EOF'
Usage: poorman-aws [global options] COMMAND [command options]

Commands:
  config validate       Validate effective configuration.
  config show           Show effective redacted configuration.
  doctor                Check prerequisites and the consumer repository contract.
  onboard               Generate consumer config and thin caller workflows.
  parameters|ami build  Manage runtime parameters or build a reviewed AMI.
  plan|apply             Dispatch a protected infrastructure plan or apply.
  release|rollback      Dispatch an immutable backend release operation.
  lifecycle              Dispatch guarded non-production lifecycle operations.

Global options:
  --config PATH         Explicit YAML configuration file.
  --non-interactive     Refuse prompts.
  --json                Emit machine-readable output where supported.
  --dry-run             Never mutate files or call mutating operations.
  --overwrite           Allow replacing generated files after conflict checks.
  --offline             Skip AWS and GitHub checks.
  --aws                 Check AWS CLI identity and configured region.
  --docker              Check Docker Compose and the consumer Compose file.
  --infra               Check OpenTofu and infrastructure prerequisites.
  --ami                 Check Packer and AMI-build prerequisites.
  --github              Check GitHub CLI authentication.
  Operational options are accepted after the command; use --help with a
  command in a consumer repository for the required values.
  --help, --version

Precedence: built-in defaults < YAML configuration < command-line options.
EOF
}

die() { echo "poorman-aws: $*" >&2; exit 2; }
warn() { echo "poorman-aws: warning: $*" >&2; }

allowed_key() {
  case "$1" in
    version|application_name|infrastructure_repository|infrastructure_ref|\
    aws.region|aws.state_bucket|aws.availability_zone|aws.route53_zone_name|\
    aws.route53_zone_id|backend.parameter_path|backend.compose_file|\
    backend.caddy_file|backend.build_context|backend.dockerfile|\
    backend.supplemental_files|defaults.instance_type|defaults.root_volume_size_gib|\
    defaults.data_volume_size_gib|defaults.release_retention_days|\
    defaults.enable_data_volume_backups|defaults.backup_kms_key_arn|\
    defaults.retain_data_volume|defaults.retain_eip)
      return 0 ;;
    *) return 1 ;;
  esac
}

set_value() {
  local key="$1" value="$2" source="$3"
  allowed_key "$key" || die "unsupported configuration key: $key"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* && "$value" != *$'\t'* ]] ||
    die "configuration value for $key contains a prohibited control character"
  values["$key"]="$value"
  sources["$key"]="$source"
}

load_yaml_lines() {
  local path="$1"
  [[ -r "$path" ]] || die "configuration file is not readable: $path"
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
    python3 - "$path" <<'PY'
import sys
import yaml

allowed = {
    "version", "application_name", "infrastructure_repository",
    "infrastructure_ref", "aws.region", "aws.state_bucket",
    "aws.availability_zone", "aws.route53_zone_name", "aws.route53_zone_id",
    "backend.parameter_path", "backend.compose_file", "backend.caddy_file",
    "backend.build_context", "backend.dockerfile", "backend.supplemental_files",
    "defaults.instance_type", "defaults.root_volume_size_gib",
    "defaults.data_volume_size_gib", "defaults.release_retention_days",
    "defaults.enable_data_volume_backups", "defaults.backup_kms_key_arn",
    "defaults.retain_data_volume", "defaults.retain_eip",
}

with open(sys.argv[1], encoding="utf-8") as stream:
    document = yaml.safe_load(stream) or {}
if not isinstance(document, dict):
    raise SystemExit("configuration root must be a YAML mapping")

def flatten(value, prefix=""):
    if isinstance(value, dict):
        for key, child in value.items():
            if not isinstance(key, str):
                raise SystemExit("configuration keys must be strings")
            child_key = f"{prefix}.{key}" if prefix else key
            yield from flatten(child, child_key)
    elif isinstance(value, (str, int, float, bool)) or value is None:
        rendered = "" if value is None else str(value).lower() if isinstance(value, bool) else str(value)
        yield prefix, rendered
    else:
        raise SystemExit(f"configuration value for {prefix} must be scalar")

for key, value in flatten(document):
    if key not in allowed:
        raise SystemExit(f"unsupported configuration key: {key}")
    print(f"{key}\t{value}")
PY
    return
  fi

  if command -v ruby >/dev/null 2>&1 && ruby -e 'require "yaml"' >/dev/null 2>&1; then
    ruby -ryaml - "$path" <<'RUBY'
allowed = %w[
  version application_name infrastructure_repository infrastructure_ref
  aws.region aws.state_bucket aws.availability_zone aws.route53_zone_name
  aws.route53_zone_id backend.parameter_path backend.compose_file
  backend.caddy_file backend.build_context backend.dockerfile backend.supplemental_files
  defaults.instance_type defaults.root_volume_size_gib defaults.data_volume_size_gib
  defaults.release_retention_days defaults.enable_data_volume_backups
  defaults.backup_kms_key_arn defaults.retain_data_volume defaults.retain_eip
]
document = YAML.safe_load(File.read(ARGV.fetch(0)), permitted_classes: [], aliases: false) || {}
abort 'configuration root must be a YAML mapping' unless document.is_a?(Hash)
flatten = lambda do |value, prefix = '', &block|
  if value.is_a?(Hash)
    value.each do |key, child|
      abort 'configuration keys must be strings' unless key.is_a?(String)
      flatten.call(child, prefix.empty? ? key : "#{prefix}.#{key}", &block)
    end
  elsif value.is_a?(String) || value.is_a?(Numeric) || value == true || value == false || value.nil?
    block.call(prefix, value.nil? ? '' : value.to_s)
  else
    abort "configuration value for #{prefix} must be scalar"
  end
end
flatten.call(document) do |key, value|
  abort "unsupported configuration key: #{key}" unless allowed.include?(key)
  puts "#{key}\t#{value}"
end
RUBY
    return
  fi

  die "YAML configuration requires Python 3 with PyYAML or Ruby with Psych"
}

load_defaults() {
  set_value version 1 default
  set_value application_name application default
  set_value infrastructure_repository kanutocd/poorman-aws default
  set_value infrastructure_ref main default
  set_value aws.region ap-southeast-1 default
  set_value aws.availability_zone '' default
  set_value aws.route53_zone_name '' default
  set_value aws.route53_zone_id '' default
  set_value backend.parameter_path /application/staging default
  set_value backend.compose_file backend/compose.production.yaml default
  set_value backend.caddy_file backend/Caddyfile default
  set_value backend.build_context backend default
  set_value backend.dockerfile backend/Dockerfile default
  set_value backend.supplemental_files '' default
  set_value defaults.instance_type t4g.micro default
  set_value defaults.root_volume_size_gib 10 default
  set_value defaults.data_volume_size_gib 20 default
  set_value defaults.release_retention_days 30 default
  set_value defaults.enable_data_volume_backups true default
  set_value defaults.backup_kms_key_arn '' default
  set_value defaults.retain_data_volume true default
  set_value defaults.retain_eip true default
}

load_config() {
  local path='' parsed=''
  if [[ "$config_explicit" == true ]]; then
    path="$config_path"
  elif [[ -f .poorman-aws.yml && -f .poorman-aws.yaml ]]; then
    die 'both .poorman-aws.yml and .poorman-aws.yaml exist; use --config'
  elif [[ -f .poorman-aws.yml ]]; then
    path=.poorman-aws.yml
  elif [[ -f .poorman-aws.yaml ]]; then
    path=.poorman-aws.yaml
  fi
  [[ -z "$path" ]] && return
  parsed="$(load_yaml_lines "$path")" || die "could not load configuration: $path"
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" ]] && set_value "$key" "$value" "config:$path"
  done <<< "$parsed"
}

parse_args() {
  local key value arg
  (($# > 0)) || { usage; exit 0; }
  while (($# > 0)); do
    arg="$1"
    case "$arg" in
      --help|-h) usage; exit 0 ;;
      --version) printf '%s\n' 'poorman-aws wrapper contract 0.1.0'; exit 0 ;;
      --config) (($# >= 2)) || die '--config requires a path'; config_path="$2"; config_explicit=true; shift 2; continue ;;
      --non-interactive) non_interactive=true; shift; continue ;;
      --json) json_output=true; shift; continue ;;
      --dry-run) dry_run=true; shift; continue ;;
      --overwrite) overwrite=true; shift; continue ;;
      --offline) offline=true; shift; continue ;;
      --aws) check_aws=true; shift; continue ;;
      --docker) check_docker=true; shift; continue ;;
      --infra) check_infra=true; shift; continue ;;
      --ami) check_ami=true; shift; continue ;;
      --github) check_github=true; shift; continue ;;
      --environment) (($# >= 2)) || die '--environment requires a value'; command_environment="$2"; shift 2; continue ;;
      --apply) command_apply=true; shift; continue ;;
      --confirm) (($# >= 2)) || die '--confirm requires a value'; command_confirm="$2"; shift 2; continue ;;
      --repo) (($# >= 2)) || die '--repo requires a value'; command_repo="$2"; shift 2; continue ;;
      --release-id) (($# >= 2)) || die '--release-id requires a value'; command_release_id="$2"; shift 2; continue ;;
      --action) (($# >= 2)) || die '--action requires a value'; command_action="$2"; shift 2; continue ;;
      --subnet-id) (($# >= 2)) || die '--subnet-id requires a value'; command_subnet_id="$2"; shift 2; continue ;;
      --ssh-cidr) (($# >= 2)) || die '--ssh-cidr requires a value'; command_ssh_cidr="$2"; shift 2; continue ;;
      --ami-name-prefix) (($# >= 2)) || die '--ami-name-prefix requires a value'; command_ami_name_prefix="$2"; shift 2; continue ;;
      --from-env-file) (($# >= 2)) || die '--from-env-file requires a path'; command_env_file="$2"; shift 2; continue ;;
      --clear-parameter) (($# >= 2)) || die '--clear-parameter requires a name'; command_clear_parameter="$2"; shift 2; continue ;;
      --non-secret) (($# >= 2)) || die '--non-secret requires a name'; command_non_secret_parameters+=("$2"); shift 2; continue ;;
      --allow-type-change) command_allow_type_change=true; shift; continue ;;
      --release-file) (($# >= 2)) || die '--release-file requires DEST=PATH'; command_supplemental_files+=("$2"); shift 2; continue ;;
      --wait) command_wait=true; shift; continue ;;
      --availability-zone) key=aws.availability_zone ;;
      --route53-zone-name) key=aws.route53_zone_name ;;
      --route53-zone-id) key=aws.route53_zone_id ;;
      --release-retention-days) key=defaults.release_retention_days ;;
      --backup-kms-key-arn) key=defaults.backup_kms_key_arn ;;
      --retain-data-volume) cli_values[defaults.retain_data_volume]=true; shift; continue ;;
      --retain-eip) cli_values[defaults.retain_eip]=true; shift; continue ;;
      --application-name) key=application_name ;;
      --infrastructure-repository) key=infrastructure_repository ;;
      --infrastructure-ref) key=infrastructure_ref ;;
      --aws-region) key=aws.region ;;
      --state-bucket) key=aws.state_bucket ;;
      --parameter-path) key=backend.parameter_path ;;
      --compose-file) key=backend.compose_file ;;
      --caddy-file) key=backend.caddy_file ;;
      --build-context) key=backend.build_context ;;
      --dockerfile) key=backend.dockerfile ;;
      --instance-type) key=defaults.instance_type ;;
      --root-volume-size-gib) key=defaults.root_volume_size_gib ;;
      --data-volume-size-gib) key=defaults.data_volume_size_gib ;;
      --*) die "unknown option: $arg" ;;
      *)
        if [[ -z "$command_name" ]]; then command_name="$arg"; else command_args+=("$arg"); fi
        shift
        continue ;;
    esac
    (($# >= 2)) || die "$arg requires a value"
    cli_values["$key"]="$2"
    shift 2
  done
  [[ -n "$command_name" ]] || die 'a command is required'
}

apply_cli_values() {
  local key
  for key in "${!cli_values[@]}"; do set_value "$key" "${cli_values[$key]}" cli; done
}

validate_values() {
  [[ "${values[version]}" == 1 ]] || die 'configuration version must be 1'
  [[ "${values[application_name]}" =~ ^[a-z][a-z0-9-]{1,32}$ ]] ||
    die 'application_name must be 2-33 lowercase letters, numbers, or hyphens'
  [[ "${values[infrastructure_repository]}" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] ||
    die 'infrastructure_repository must be OWNER/REPOSITORY'
  [[ -n "${values[infrastructure_ref]}" && "${values[infrastructure_ref]}" != *' '* ]] ||
    die 'infrastructure_ref must be a non-empty ref'
  [[ "${values[aws.region]}" =~ ^[a-z0-9-]+$ ]] || die 'aws.region is invalid'
  if [[ -n "${values[aws.availability_zone]}" ]]; then
    [[ "${values[aws.availability_zone]}" =~ ^[a-z0-9-]+$ ]] || die 'aws.availability_zone is invalid'
  fi
  [[ -z "${values[aws.route53_zone_name]}" || "${values[aws.route53_zone_name]}" =~ ^[A-Za-z0-9.-]+$ ]] ||
    die 'aws.route53_zone_name is invalid'
  [[ "${values[backend.parameter_path]}" =~ ^/[^/].*[^/]$ ]] ||
    die 'backend.parameter_path must be an absolute SSM path'
  [[ "${values[defaults.instance_type]}" =~ ^[a-z0-9.-]+$ ]] || die 'instance_type is invalid'
  [[ "${values[defaults.root_volume_size_gib]}" =~ ^[0-9]+$ && "${values[defaults.root_volume_size_gib]}" -ge 8 ]] ||
    die 'root_volume_size_gib must be an integer of at least 8'
  [[ "${values[defaults.data_volume_size_gib]}" =~ ^[0-9]+$ && "${values[defaults.data_volume_size_gib]}" -ge 8 ]] ||
    die 'data_volume_size_gib must be an integer of at least 8'
  [[ "${values[defaults.release_retention_days]}" =~ ^[0-9]+$ && "${values[defaults.release_retention_days]}" -ge 1 ]] ||
    die 'release_retention_days must be an integer of at least 1'
  [[ "${values[defaults.enable_data_volume_backups]}" =~ ^(true|false)$ ]] ||
    die 'enable_data_volume_backups must be true or false'
  [[ "${values[defaults.retain_data_volume]}" =~ ^(true|false)$ ]] ||
    die 'retain_data_volume must be true or false'
  [[ "${values[defaults.retain_eip]}" =~ ^(true|false)$ ]] ||
    die 'retain_eip must be true or false'
}

show_config() {
  local key
  if [[ "$json_output" == true ]]; then
    command -v jq >/dev/null 2>&1 || die '--json requires jq'
    for key in "${!values[@]}"; do printf '%s\t%s\t%s\n' "$key" "${values[$key]}" "${sources[$key]}"; done |
      sort | jq -Rn '[inputs | split("\t") | {key: .[0], value: .[1], source: .[2]}]'
  else
    while IFS= read -r key; do
      printf '%-36s %s (source: %s)\n' "$key" "${values[$key]}" "${sources[$key]}"
    done < <(printf '%s\n' "${!values[@]}" | sort)
  fi
}

prompt_value() {
  local key="$1" label="$2" required="${3:-false}" current="${values[$1]-}" answer
  if [[ -n "$current" && ( "${sources[$key]-}" != default || "$required" != true ) ]]; then
    return
  fi
  if [[ "$non_interactive" == true ]]; then
    die "$key is required in --non-interactive mode; set it in --config or on the command line"
  fi
  printf '%s [%s]: ' "$label" "$current" >&2
  IFS= read -r answer
  [[ -n "$answer" ]] && set_value "$key" "$answer" prompt
}

detect_onboarding_paths() {
  local candidate
  if [[ "${sources[backend.compose_file]-}" == default ]]; then
    for candidate in deployment/backend/compose.production.yaml backend/compose.production.yaml compose.yaml; do
      if [[ -f "$PWD/$candidate" ]]; then set_value backend.compose_file "$candidate" detected; break; fi
    done
  fi
  if [[ "${sources[backend.caddy_file]-}" == default ]]; then
    for candidate in deployment/backend/Caddyfile backend/Caddyfile Caddyfile; do
      if [[ -f "$PWD/$candidate" ]]; then set_value backend.caddy_file "$candidate" detected; break; fi
    done
  fi
  if [[ "${sources[backend.dockerfile]-}" == default ]]; then
    for candidate in backend/Dockerfile Dockerfile; do
      if [[ -f "$PWD/$candidate" ]]; then set_value backend.dockerfile "$candidate" detected; break; fi
    done
  fi
}

require_onboarding_values() {
  detect_onboarding_paths
  prompt_value application_name 'Application name' true
  prompt_value infrastructure_repository 'Infrastructure repository'
  prompt_value infrastructure_ref 'Immutable infrastructure ref (tag or commit SHA)' true
  prompt_value aws.region 'AWS region'
  prompt_value aws.availability_zone 'AWS availability zone' true
  prompt_value aws.route53_zone_name 'Route 53 zone name' true
  prompt_value aws.state_bucket 'Encrypted remote state bucket' true
  prompt_value backend.parameter_path 'SSM parameter path'
  prompt_value backend.compose_file 'Consumer Compose file'
  prompt_value backend.caddy_file 'Consumer Caddyfile'
  prompt_value backend.build_context 'Docker build context'
  prompt_value backend.dockerfile 'Application Dockerfile'
  validate_values
  [[ "${values[infrastructure_ref]}" != main && "${values[infrastructure_ref]}" != master ]] ||
    die 'onboarding requires an immutable infrastructure ref; use a release tag or commit SHA'
  local key
  for key in application_name infrastructure_repository infrastructure_ref aws.region aws.availability_zone \
    aws.route53_zone_name aws.state_bucket \
    backend.parameter_path backend.compose_file backend.caddy_file backend.build_context backend.dockerfile; do
    [[ "${values[$key]}" != *'|'* ]] || die "$key cannot contain the template delimiter |"
  done
}

onboarding_tmp=''
onboard_cleanup() {
  [[ -z "$onboarding_tmp" ]] || rm -rf "$onboarding_tmp"
}

stage_onboarding_file() {
  local target="$1" content="$2" staged
  staged="$onboarding_tmp/$(printf '%s' "$target" | tr '/' '_')"
  mkdir -p "$(dirname "$staged")"
  printf '%s\n' "$content" >"$staged"
  generated_targets+=("$target")
  generated_sources+=("$staged")
}

render_workflow() {
  local template="$1"
  template="${template//__REPOSITORY__/${values[infrastructure_repository]}}"
  template="${template//__REF__/${values[infrastructure_ref]}}"
  template="${template//__APP__/${values[application_name]}}"
  template="${template//__REGION__/${values[aws.region]}}"
  template="${template//__AZ__/${values[aws.availability_zone]}}"
  template="${template//__ZONE__/${values[aws.route53_zone_name]}}"
  template="${template//__ZONE_ID__/${values[aws.route53_zone_id]}}"
  template="${template//__STATE_BUCKET__/${values[aws.state_bucket]}}"
  template="${template//__PARAMETER_PATH__/${values[backend.parameter_path]}}"
  template="${template//__COMPOSE__/${values[backend.compose_file]}}"
  template="${template//__CADDY__/${values[backend.caddy_file]}}"
  template="${template//__CONTEXT__/${values[backend.build_context]}}"
  template="${template//__DOCKERFILE__/${values[backend.dockerfile]}}"
  template="${template//__SUPPLEMENTAL_FILES__/${values[backend.supplemental_files]}}"
  template="${template//__INSTANCE_TYPE__/${values[defaults.instance_type]}}"
  template="${template//__ROOT_VOLUME_SIZE__/${values[defaults.root_volume_size_gib]}}"
  template="${template//__DATA_VOLUME_SIZE__/${values[defaults.data_volume_size_gib]}}"
  template="${template//__RETAIN_EIP__/${values[defaults.retain_eip]}}"
  template="${template//__RETAIN_DATA_VOLUME__/${values[defaults.retain_data_volume]}}"
  template="${template//__RELEASE_RETENTION_DAYS__/${values[defaults.release_retention_days]}}"
  template="${template//__ENABLE_BACKUPS__/${values[defaults.enable_data_volume_backups]}}"
  template="${template//__BACKUP_KMS_KEY_ARN__/${values[defaults.backup_kms_key_arn]}}"
  printf '%s' "$template"
}

prepare_onboarding_files() {
  local config_content infra deploy rollback ami lifecycle parameters
  onboarding_tmp="$(mktemp -d "${TMPDIR:-/tmp}/poorman-aws-onboard.XXXXXX")"
  generated_targets=()
  generated_sources=()
  config_content="$(cat <<EOF
version: 1
application_name: ${values[application_name]}
infrastructure_repository: ${values[infrastructure_repository]}
infrastructure_ref: ${values[infrastructure_ref]}
aws:
  region: ${values[aws.region]}
  availability_zone: ${values[aws.availability_zone]}
  route53_zone_name: ${values[aws.route53_zone_name]}
  route53_zone_id: ${values[aws.route53_zone_id]}
  state_bucket: ${values[aws.state_bucket]}
backend:
  parameter_path: ${values[backend.parameter_path]}
  compose_file: ${values[backend.compose_file]}
  caddy_file: ${values[backend.caddy_file]}
  build_context: ${values[backend.build_context]}
  dockerfile: ${values[backend.dockerfile]}
  supplemental_files: ${values[backend.supplemental_files]}
defaults:
  instance_type: ${values[defaults.instance_type]}
  root_volume_size_gib: ${values[defaults.root_volume_size_gib]}
  data_volume_size_gib: ${values[defaults.data_volume_size_gib]}
  release_retention_days: ${values[defaults.release_retention_days]}
  enable_data_volume_backups: ${values[defaults.enable_data_volume_backups]}
  backup_kms_key_arn: ${values[defaults.backup_kms_key_arn]}
  retain_data_volume: ${values[defaults.retain_data_volume]}
  retain_eip: ${values[defaults.retain_eip]}
EOF
)"
  if [[ "$config_explicit" == false ]]; then stage_onboarding_file .poorman-aws.yml "$config_content"; fi

  infra="$(cat <<'EOF'
name: poorman-aws backend infrastructure
on:
  workflow_dispatch:
    inputs:
      environment:
        description: Target environment
        required: true
        default: staging
        type: choice
        options: [staging, production]
      apply:
        description: Apply infrastructure changes
        required: true
        default: false
        type: boolean
permissions:
  contents: read
jobs:
  infrastructure:
    uses: __REPOSITORY__/.github/workflows/deploy-backend-infra.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      environment: ${{ github.event_name == 'workflow_dispatch' && inputs.environment || 'staging' }}
      apply: ${{ github.event_name == 'workflow_dispatch' && inputs.apply || false }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      availability_zone: ${{ vars.AVAILABILITY_ZONE || '__AZ__' }}
      instance_type: ${{ vars.INSTANCE_TYPE || '__INSTANCE_TYPE__' }}
      root_volume_size_gib: ${{ vars.ROOT_VOLUME_SIZE_GIB || __ROOT_VOLUME_SIZE__ }}
      data_volume_size_gib: ${{ vars.DATA_VOLUME_SIZE_GIB || __DATA_VOLUME_SIZE__ }}
      retain_eip: ${{ vars.RETAIN_EIP || __RETAIN_EIP__ }}
      retain_data_volume: ${{ vars.RETAIN_DATA_VOLUME || __RETAIN_DATA_VOLUME__ }}
      release_retention_days: ${{ vars.RELEASE_RETENTION_DAYS || __RELEASE_RETENTION_DAYS__ }}
      enable_data_volume_backups: ${{ vars.ENABLE_DATA_VOLUME_BACKUPS || __ENABLE_BACKUPS__ }}
      backup_kms_key_arn: ${{ vars.BACKUP_KMS_KEY_ARN || '__BACKUP_KMS_KEY_ARN__' }}
      ssm_parameter_path: __PARAMETER_PATH__
      ssm_session_kms_key_arn: ${{ vars.SSM_SESSION_KMS_KEY_ARN }}
      route53_zone_name: ${{ vars.ROUTE53_ZONE_NAME || '__ZONE__' }}
      route53_zone_id: ${{ vars.ROUTE53_ZONE_ID || '__ZONE_ID__' }}
      tags_json: '{}'
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      ami_id: ${{ secrets.AMI_ID }}
EOF
)"
  deploy="$(cat <<'EOF'
name: poorman-aws backend deploy
on:
  workflow_dispatch:
    inputs:
      environment:
        required: true
        default: staging
        type: choice
        options: [staging, production]
      supplemental_files:
        description: Optional comma-separated DEST=PATH release files
        required: false
        default: ''
        type: string
permissions:
  contents: read
jobs:
  deploy:
    uses: __REPOSITORY__/.github/workflows/deploy-backend.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      environment: ${{ inputs.environment }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      api_url: ${{ vars.API_URL }}
      compose_file: __COMPOSE__
      caddy_file: __CADDY__
      build_context: __CONTEXT__
      dockerfile: __DOCKERFILE__
      supplemental_files: ${{ inputs.supplemental_files || '__SUPPLEMENTAL_FILES__' }}
      frontend_url: ${{ vars.FRONTEND_URL }}
      frontend_origin: ${{ vars.FRONTEND_ORIGIN }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      application_api_token: ${{ secrets.APPLICATION_API_TOKEN }}
EOF
)"
  rollback="$(cat <<'EOF'
name: poorman-aws backend rollback
on:
  workflow_dispatch:
    inputs:
      environment:
        required: true
        default: staging
        type: choice
        options: [staging, production]
      release_id:
        required: true
        type: string
permissions:
  contents: read
jobs:
  rollback:
    uses: __REPOSITORY__/.github/workflows/rollback-backend.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      consumer_ref: ${{ github.sha }}
      application_name: __APP__
      environment: ${{ inputs.environment }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      release_id: ${{ inputs.release_id }}
      api_url: ${{ vars.API_URL }}
      compose_file: __COMPOSE__
      caddy_file: __CADDY__
      frontend_url: ${{ vars.FRONTEND_URL }}
      frontend_origin: ${{ vars.FRONTEND_ORIGIN }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      application_api_token: ${{ secrets.APPLICATION_API_TOKEN }}
EOF
)"
  ami="$(cat <<'EOF'
name: poorman-aws backend AMI
on:
  workflow_dispatch:
    inputs:
      subnet_id:
        required: true
        type: string
      ssh_cidr:
        required: true
        type: string
      ami_name_prefix:
        required: true
        default: __APP__-backend
        type: string
permissions:
  contents: read
jobs:
  ami:
    uses: __REPOSITORY__/.github/workflows/build-backend-ami.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      aws_region: __REGION__
      subnet_id: ${{ inputs.subnet_id }}
      ssh_cidr: ${{ inputs.ssh_cidr }}
      ami_name_prefix: ${{ inputs.ami_name_prefix }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
EOF
)"
  lifecycle="$(cat <<'EOF'
name: poorman-aws non-production lifecycle
on:
  workflow_dispatch:
    inputs:
      action:
        description: Guarded staging lifecycle action
        required: true
        default: STOP
        type: choice
        options: [STOP, DESTROY, NUKE]
      confirmation:
        description: Must match ACTION-STAGING when applying
        required: true
        type: string
      apply:
        description: Execute the selected action
        required: true
        default: false
        type: boolean
permissions:
  contents: read
jobs:
  lifecycle:
    uses: __REPOSITORY__/.github/workflows/kill-non-production.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      environment: staging
      action: ${{ inputs.action }}
      confirmation: ${{ inputs.confirmation }}
      apply: ${{ inputs.apply }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      availability_zone: ${{ vars.AVAILABILITY_ZONE || '__AZ__' }}
      instance_type: ${{ vars.INSTANCE_TYPE || '__INSTANCE_TYPE__' }}
      root_volume_size_gib: ${{ vars.ROOT_VOLUME_SIZE_GIB || __ROOT_VOLUME_SIZE__ }}
      data_volume_size_gib: ${{ vars.DATA_VOLUME_SIZE_GIB || __DATA_VOLUME_SIZE__ }}
      retain_eip: ${{ vars.RETAIN_EIP || __RETAIN_EIP__ }}
      retain_data_volume: ${{ vars.RETAIN_DATA_VOLUME || __RETAIN_DATA_VOLUME__ }}
      release_retention_days: ${{ vars.RELEASE_RETENTION_DAYS || __RELEASE_RETENTION_DAYS__ }}
      enable_data_volume_backups: ${{ vars.ENABLE_DATA_VOLUME_BACKUPS || __ENABLE_BACKUPS__ }}
      backup_kms_key_arn: ${{ vars.BACKUP_KMS_KEY_ARN || '__BACKUP_KMS_KEY_ARN__' }}
      ssm_parameter_path: __PARAMETER_PATH__
      ssm_session_kms_key_arn: ${{ vars.SSM_SESSION_KMS_KEY_ARN }}
      route53_zone_name: ${{ vars.ROUTE53_ZONE_NAME || '__ZONE__' }}
      route53_zone_id: ${{ vars.ROUTE53_ZONE_ID || '__ZONE_ID__' }}
      tags_json: '{}'
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      ami_id: ${{ secrets.AMI_ID }}
EOF
 )"
  parameters="$(cat <<'EOF'
name: poorman-aws backend parameters
on:
  workflow_dispatch:
    inputs:
      environment:
        required: true
        default: staging
        type: choice
        options: [staging, production]
      apply:
        description: Write the protected runtime parameters
        required: true
        default: false
        type: boolean
      clear_parameter:
        description: Optional uppercase parameter name to delete
        required: false
        type: string
permissions:
  contents: read
  id-token: write
jobs:
  parameters:
    uses: __REPOSITORY__/.github/workflows/bootstrap-backend-parameters.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      environment: ${{ inputs.environment }}
      apply: ${{ inputs.apply }}
      clear_parameter: ${{ inputs.clear_parameter }}
      aws_region: __REGION__
      parameter_path: __PARAMETER_PATH__
      non_secret_parameters: ${{ vars.NON_SECRET_PARAMETERS }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      environment_parameters: ${{ secrets.RUNTIME_PARAMETERS }}
EOF
 )"
  stage_onboarding_file .github/workflows/poorman-aws-backend-infra.yml "$(render_workflow "$infra")"
  stage_onboarding_file .github/workflows/poorman-aws-backend-deploy.yml "$(render_workflow "$deploy")"
  stage_onboarding_file .github/workflows/poorman-aws-backend-rollback.yml "$(render_workflow "$rollback")"
  stage_onboarding_file .github/workflows/poorman-aws-backend-ami.yml "$(render_workflow "$ami")"
  stage_onboarding_file .github/workflows/poorman-aws-lifecycle.yml "$(render_workflow "$lifecycle")"
  stage_onboarding_file .github/workflows/poorman-aws-backend-parameters.yml "$(render_workflow "$parameters")"
}

write_onboarding_files() {
  local index target source conflict=false
  for index in "${!generated_targets[@]}"; do
    target="${generated_targets[$index]}"
    source="${generated_sources[$index]}"
    if [[ -e "$target" ]] && ! cmp -s "$source" "$target"; then
      if [[ "$overwrite" != true ]]; then
        echo "conflict: $target already exists and differs; rerun with --overwrite after reviewing it" >&2
        conflict=true
      fi
    fi
  done
  [[ "$conflict" == false ]] || { onboard_cleanup; exit 2; }
  for index in "${!generated_targets[@]}"; do
    target="${generated_targets[$index]}"
    source="${generated_sources[$index]}"
    if [[ "$dry_run" == true ]]; then
      echo "would generate $target"
    elif [[ -e "$target" ]] && cmp -s "$source" "$target"; then
      echo "unchanged $target"
    else
      mkdir -p "$(dirname "$target")"
      cp "$source" "$target"
      echo "generated $target"
    fi
  done
  onboard_cleanup
}

onboard() {
  require_onboarding_values
  if [[ "$non_interactive" == false ]]; then
    printf 'Generate consumer integration files for %s? [y/N]: ' "${values[application_name]}" >&2
    local confirmation
    IFS= read -r confirmation
    [[ "$confirmation" =~ ^[Yy]$ ]] || { echo 'onboarding cancelled'; return 0; }
  fi
  prepare_onboarding_files
  write_onboarding_files
}

operational_environment() {
  local environment="${command_environment:-staging}"
  [[ "$environment" =~ ^(staging|production)$ ]] || die '--environment must be staging or production'
  printf '%s\n' "$environment"
}

consumer_repository() {
  if [[ -n "$command_repo" ]]; then
    [[ "$command_repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || die '--repo must be OWNER/REPOSITORY'
    printf '%s\n' "$command_repo"
  elif [[ -n "${GH_REPOSITORY:-}" ]]; then
    printf '%s\n' "$GH_REPOSITORY"
  elif [[ "$dry_run" == true ]]; then
    printf '%s\n' '<current-consumer-repository>'
  else
    command -v gh >/dev/null 2>&1 || die 'gh is required to dispatch consumer workflows; pass --dry-run to preview'
    gh repo view --json nameWithOwner --jq .nameWithOwner
  fi
}

require_immutable_ref() {
  [[ "${values[infrastructure_ref]}" != main && "${values[infrastructure_ref]}" != master ]] ||
    die 'operational commands require an immutable infrastructure ref; use a release tag or commit SHA'
}

require_mutation_confirmation() {
  local expected="$1" answer
  [[ "$command_apply" == true ]] || die "mutating operation requires --apply --confirm $expected"
  if [[ "$command_confirm" != "$expected" && "$non_interactive" == true ]]; then
    die "--non-interactive mutating operation requires --confirm $expected"
  fi
  if [[ "$command_confirm" != "$expected" ]]; then
    printf 'Type %s to continue: ' "$expected" >&2
    IFS= read -r answer
    [[ "$answer" == "$expected" ]] || die 'confirmation did not match; operation cancelled'
  fi
}

dispatch_workflow() {
  local workflow="$1" repo="$2" field run_args=()
  shift 2
  run_args=(workflow run "$workflow" --repo "$repo")
  while (($# > 0)); do
    field="$1"
    run_args+=(-f "$field")
    shift
  done
  if [[ "$dry_run" == true ]]; then
    printf 'would dispatch:'
    printf ' %q' gh "${run_args[@]}"
    printf '\n'
    return
  fi
  command -v gh >/dev/null 2>&1 || die 'gh is required to dispatch a consumer workflow'
  gh "${run_args[@]}"
  echo "dispatched $workflow in $repo"
  if [[ "$command_wait" == true ]]; then
    die '--wait is not supported because GitHub does not return a run ID from workflow dispatch'
  fi
}

parameters_adapter() {
  local environment repo
  environment="$(operational_environment)"
  require_immutable_ref
  [[ -n "$command_env_file" || -n "$command_clear_parameter" ]] ||
    die 'parameters requires --from-env-file or --clear-parameter'
  if [[ "$command_apply" == true ]]; then
    require_mutation_confirmation "PARAMETERS-${environment^^}"
  fi
  if [[ -n "$command_env_file" ]]; then
    [[ -x "$script_directory/bootstrap-backend-parameters" ]] ||
      die 'this remote wrapper cannot read local parameter files; use the generated parameters workflow with RUNTIME_PARAMETERS'
    local parameter_args=(
      --environment "$environment"
      --application-name "${values[application_name]}"
      --parameter-path "${values[backend.parameter_path]}"
      --from-env-file "$command_env_file"
    )
    local parameter
    for parameter in "${command_non_secret_parameters[@]}"; do parameter_args+=(--non-secret "$parameter"); done
    [[ "$command_allow_type_change" == true ]] && parameter_args+=(--allow-type-change)
    [[ "$command_apply" == true ]] && parameter_args+=(--apply)
    AWS_REGION="${values[aws.region]}" "$script_directory/bootstrap-backend-parameters" "${parameter_args[@]}"
    return
  fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-parameters.yml "$repo" \
    "environment=$environment" \
    "apply=$command_apply" \
    "clear_parameter=$command_clear_parameter"
}

infrastructure_adapter() {
  local environment repo apply_value
  environment="$(operational_environment)"
  require_immutable_ref
  if [[ "$command_name" == apply ]]; then
    require_mutation_confirmation "APPLY-${environment^^}"
    apply_value=true
  else
    apply_value=false
  fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-infra.yml "$repo" \
    "environment=$environment" "apply=$apply_value"
}

release_adapter() {
  local environment repo supplemental=''
  environment="$(operational_environment)"
  require_immutable_ref
  require_mutation_confirmation "RELEASE-${environment^^}"
  repo="$(consumer_repository)"
  if ((${#command_supplemental_files[@]} > 0)); then
    supplemental="$(IFS=,; printf '%s' "${command_supplemental_files[*]}")"
  fi
  dispatch_workflow poorman-aws-backend-deploy.yml "$repo" \
    "environment=$environment" "supplemental_files=$supplemental"
}

rollback_adapter() {
  local environment repo
  environment="$(operational_environment)"
  require_immutable_ref
  [[ "$command_release_id" =~ ^[0-9a-f]{7,64}$ ]] ||
    die 'rollback requires --release-id with a hexadecimal release identifier'
  require_mutation_confirmation "ROLLBACK-${environment^^}"
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-rollback.yml "$repo" \
    "environment=$environment" "release_id=$command_release_id"
}

ami_adapter() {
  local repo
  require_immutable_ref
  [[ -n "$command_subnet_id" && -n "$command_ssh_cidr" ]] ||
    die 'ami build requires --subnet-id and --ssh-cidr'
  command_ami_name_prefix="${command_ami_name_prefix:-${values[application_name]}-backend}"
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-ami.yml "$repo" \
    "subnet_id=$command_subnet_id" "ssh_cidr=$command_ssh_cidr" \
    "ami_name_prefix=$command_ami_name_prefix"
}

lifecycle_adapter() {
  local environment repo action
  environment="$(operational_environment)"
  [[ "$environment" == staging ]] || die 'lifecycle is restricted to staging'
  require_immutable_ref
  action="${command_action:-${command_args[0]:-}}"
  [[ "$action" =~ ^(STOP|DESTROY|NUKE)$ ]] || die 'lifecycle requires --action STOP|DESTROY|NUKE'
  if [[ "$command_apply" == true ]]; then require_mutation_confirmation "${action}-STAGING"; fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-lifecycle.yml "$repo" \
    "action=$action" "confirmation=$command_confirm" "apply=$command_apply"
}

operational_adapter() {
  case "$command_name" in
    parameters) parameters_adapter ;;
    plan|apply) infrastructure_adapter ;;
    release) release_adapter ;;
    rollback) rollback_adapter ;;
    lifecycle) lifecycle_adapter ;;
    ami)
      [[ "${command_args[0]:-build}" == build ]] || die 'usage: ami build'
      ami_adapter ;;
    *) die "unsupported operational command: $command_name" ;;
  esac
}

doctor_failure=0

doctor_fail() {
  echo "missing: $1" >&2
  echo "hint: $2" >&2
  doctor_failure=1
}

doctor_command() {
  local name="$1" hint="$2"
  if command -v "$name" >/dev/null 2>&1; then
    echo "ok: $name ($(command -v "$name"))"
  else
    doctor_fail "$name" "$hint"
  fi
}

consumer_path() {
  local configured_path="$1"
  if [[ "$configured_path" == /* ]]; then
    printf '%s\n' "$configured_path"
  else
    printf '%s/%s\n' "$PWD" "$configured_path"
  fi
}

doctor_file() {
  local label="$1" path="$2" hint="$3"
  if [[ -f "$path" ]]; then
    echo "ok: $label ($path)"
  else
    doctor_fail "$label ($path)" "$hint"
  fi
}

doctor_directory() {
  local label="$1" path="$2" hint="$3"
  if [[ -d "$path" ]]; then
    echo "ok: $label ($path)"
  else
    doctor_fail "$label ($path)" "$hint"
  fi
}

doctor_resolve_file() {
  local label="$1" option="$2" configured="$3" candidate
  shift 3
  if [[ -f "$configured" ]]; then
    printf '%s\n' "$configured"
    return
  fi
  for candidate in "$@"; do
    if [[ -f "$PWD/$candidate" ]]; then
      echo "hint: detected $label at $PWD/$candidate; use --$option to make this explicit" >&2
      printf '%s\n' "$PWD/$candidate"
      return
    fi
  done
  printf '%s\n' "$configured"
}

doctor_consumer_contract() {
  local compose_file caddy_file dockerfile build_context
  compose_file="$(doctor_resolve_file 'Compose file' compose-file "$(consumer_path "${values[backend.compose_file]}")" \
    deployment/backend/compose.production.yaml backend/compose.production.yaml compose.yaml)"
  caddy_file="$(doctor_resolve_file Caddyfile caddy-file "$(consumer_path "${values[backend.caddy_file]}")" \
    deployment/backend/Caddyfile backend/Caddyfile Caddyfile)"
  dockerfile="$(doctor_resolve_file Dockerfile dockerfile "$(consumer_path "${values[backend.dockerfile]}")" \
    backend/Dockerfile Dockerfile)"
  build_context="$(consumer_path "${values[backend.build_context]}")"
  doctor_file 'Compose file' "$compose_file" \
    'set backend.compose_file to the consumer-owned Compose path'
  doctor_file 'Caddyfile' "$caddy_file" \
    'set backend.caddy_file to the consumer-owned reverse-proxy configuration'
  doctor_file 'Dockerfile' "$dockerfile" \
    'set backend.dockerfile to the application image Dockerfile'
  doctor_directory 'Docker build context' "$build_context" \
    'set backend.build_context to the application image build directory'

  if [[ -z "${values[aws.state_bucket]-}" ]]; then
    doctor_fail 'aws.state_bucket' \
      'set the encrypted remote OpenTofu state bucket in YAML or with --state-bucket'
  else
    echo "ok: aws.state_bucket (${values[aws.state_bucket]})"
  fi
}

doctor_docker() {
  local compose_file
  doctor_command docker 'install Docker Desktop or Docker Engine with Compose v2'
  if ! command -v docker >/dev/null 2>&1; then return; fi
  if docker compose version >/dev/null 2>&1; then
    echo "ok: docker compose ($(docker compose version --short 2>/dev/null || echo available))"
  else
    doctor_fail 'docker compose' 'install or enable the Docker Compose v2 plugin'
    return
  fi
  compose_file="$(consumer_path "${values[backend.compose_file]}")"
  if [[ -f "$compose_file" ]] && docker compose -f "$compose_file" config --quiet >/dev/null 2>&1; then
    echo "ok: Compose configuration parses ($compose_file)"
  elif [[ -f "$compose_file" ]]; then
    doctor_fail 'Compose configuration' \
      'run docker compose config with the consumer runtime environment and fix interpolation or syntax errors'
  fi
}

doctor_aws() {
  local identity account
  doctor_command aws 'install AWS CLI v2 and configure an allowed identity'
  if ! command -v aws >/dev/null 2>&1; then return; fi
  identity="$(aws sts get-caller-identity --region "${values[aws.region]}" --output json 2>/dev/null || true)"
  account="$(jq -r '.Account // empty' <<<"$identity" 2>/dev/null || true)"
  if [[ "$account" =~ ^[0-9]{12}$ ]]; then
    echo "ok: AWS identity (account $account, region ${values[aws.region]})"
  else
    doctor_fail 'AWS identity' \
      'authenticate AWS CLI with an identity permitted to inspect the configured environment'
  fi
}

doctor_github() {
  doctor_command gh 'install GitHub CLI and run gh auth login'
  if ! command -v gh >/dev/null 2>&1; then return; fi
  if gh auth status >/dev/null 2>&1; then
    echo 'ok: GitHub CLI authentication'
  else
    doctor_fail 'GitHub CLI authentication' 'run gh auth login with a token allowed to manage the requested repository'
  fi
}

doctor() {
  doctor_failure=0
  doctor_command bash 'install Bash 4+ (or use the supported system package)'
  doctor_command curl 'install curl for remote wrapper and AWS endpoint checks'
  doctor_command jq 'install jq for structured AWS and policy output'
  doctor_command git 'install Git and run this command from the consumer repository'
  if (command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1) ||
     (command -v ruby >/dev/null 2>&1 && ruby -e 'require "yaml"' >/dev/null 2>&1); then
    echo 'ok: YAML parser (Python PyYAML or Ruby Psych)'
  else
    doctor_fail 'YAML parser' 'install Python 3 with PyYAML or Ruby with Psych'
  fi
  doctor_consumer_contract

  if [[ "$offline" != true ]]; then
    if [[ "$check_aws" == true ]]; then doctor_aws; fi
    if [[ "$check_github" == true ]]; then doctor_github; fi
  else
    echo 'info: offline mode skips AWS and GitHub checks'
  fi
  if [[ "$check_docker" == true ]]; then doctor_docker; fi
  if [[ "$check_infra" == true ]]; then
    doctor_command tofu 'install OpenTofu for infrastructure planning'
  fi
  if [[ "$check_ami" == true ]]; then
    doctor_command packer 'install Packer for reviewed host AMI builds'
    doctor_command zstd 'install zstd for release and AMI artifact compression'
  fi
  [[ "$doctor_failure" -eq 0 ]]
}

reserved_command() {
  warn "command '$*' is defined by the Phase 0 contract but not implemented yet"
  warn 'use config validate/show or doctor; later phases add the operational adapter'
  exit 3
}

main() {
  parse_args "$@"
  # no-op that evaluates variables without executing them as commands to silence shellcheck's warnings
  : "$non_interactive" "$dry_run"
  load_defaults
  load_config
  apply_cli_values
  validate_values
  case "$command_name" in
    config)
      case "${command_args[0]:-}" in
        validate) echo 'configuration valid' ;;
        show) show_config ;;
        *) die 'usage: config validate|show' ;;
      esac ;;
    doctor) doctor ;;
    onboard) onboard ;;
    parameters|ami|plan|apply|release|rollback|lifecycle)
      operational_adapter ;;
    help) usage ;;
    *) die "unknown command: $command_name" ;;
  esac
}

main "$@"
