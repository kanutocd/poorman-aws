  # Keep lifecycle actions manual and confirmation-gated. Do not enable
  # push, schedule, or workflow_run triggers without a teardown review:
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
  workflow_dispatch:
    inputs:
      action:
        description: Guarded staging frontend lifecycle action
        required: true
        default: DESTROY
        type: choice
