write_onboarding_files() {
  local index target source conflict=false
  for index in "${!generated_targets[@]}"; do
    target="${generated_targets[$index]}"
    source="${generated_sources[$index]}"
    if [[ -e "$target" ]] && ! cmp -s "$source" "$target"; then
      if [[ "$target" == .poorman-aws.yml ]] && is_bootstrap_state_config "$target"; then
        echo 'replacing the minimal state-bucket bootstrap configuration with the complete onboarding configuration'
        continue
      fi
      if [[ "$overwrite" != true ]]; then
        echo "conflict: $target already exists and differs; rerun with --overwrite after reviewing their diffs displayed above" >&2
        conflict=true
      fi
    fi
  done
  [[ "$conflict" == false ]] || { onboard_cleanup; exit 2; }
  for index in "${!generated_targets[@]}"; do
    target="${generated_targets[$index]}"
    source="${generated_sources[$index]}"
    if [[ "$dry_run" == true ]]; then
      echo "would generate $target"
    elif [[ -e "$target" ]] && cmp -s "$source" "$target"; then
      echo "unchanged $target"
    else
      mkdir -p "$(dirname "$target")"
      cp "$source" "$target"
      echo "generated $target"
    fi
    if [[ "$target" == .poorman-aws.yml && "$dry_run" == false ]]; then
      persist_consumer_config_state "$target"
    fi
  done
  onboard_cleanup
}

is_bootstrap_state_config() {
  local path="$1"
  awk '
    BEGIN { entries = 0; unexpected = 0 }
    /^version: 1$/ { entries++; next }
    /^application_name: '\''[^'\''[:cntrl:]]*'\''$/ { entries++; next }
    /^aws:$/ { entries++; next }
    /^  region: '\''[^'\''[:cntrl:]]*'\''$/ { entries++; next }
    /^  state_bucket: '\''[^'\''[:cntrl:]]*'\''$/ { entries++; next }
    NF { unexpected = 1 }
    END { exit !(entries == 5 && unexpected == 0) }
  ' "$path"
}

show_onboarding_diff() {
  local index target source
  command -v diff >/dev/null 2>&1 || die 'diff is required to review onboarding changes'
  for index in "${!generated_targets[@]}"; do
    target="${generated_targets[$index]}"
    source="${generated_sources[$index]}"
    if [[ -e "$target" ]] && cmp -s "$source" "$target"; then continue; fi
    printf '\n--- onboarding change: %s ---\n' "$target" >&2
    if [[ -e "$target" ]]; then
      diff -u --label "$target (consumer)" --label "$target (generated)" "$target" "$source" || true
    else
      diff -u --label "$target (consumer: absent)" --label "$target (generated)" /dev/null "$source" || true
    fi
  done
}

onboard() {
  restore_install_state
  require_onboarding_values
  prepare_onboarding_files
  if [[ "$non_interactive" == false ]]; then
    show_onboarding_diff
    printf 'Generate consumer GitHub Actions workflow integration files for %s? [y/N]: ' "${values[application_name]}" >&2
    local confirmation
    IFS= read -r confirmation
    if [[ ! "$confirmation" =~ ^[Yy]$ ]]; then
      onboard_cleanup
      echo 'onboarding cancelled'
      return 0
    fi
  fi
  write_onboarding_files
  local command_path consumer_argument
  command_path="$(printf '%q' "$(wrapper_command)")"
  consumer_argument="$(printf '%q' "$consumer_root")"
  echo 'next: review the generated GitHub Actions workflow integration files.'
  echo 'next: when online, synchronize the consumer GitHub environments and AWS role secrets:'
  echo "  $command_path --consumer-path $consumer_argument --apply --confirm SYNC-GITHUB-ENVIRONMENTS github sync"
  echo 'next: verify the local and remote prerequisites:'
  echo "  $command_path --consumer-path $consumer_argument --aws --github --docker --infra doctor"
}

operational_environment() {
  local environment="${command_environment:-staging}"
  [[ "$environment" =~ ^(staging|production)$ ]] || die '--environment must be staging or production'
  printf '%s\n' "$environment"
}

consumer_repository() {
  if [[ -n "$command_repo" ]]; then
    [[ "$command_repo" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || die '--repo must be OWNER/REPOSITORY'
    printf '%s\n' "$command_repo"
  elif [[ -n "${GH_REPOSITORY:-}" ]]; then
    printf '%s\n' "$GH_REPOSITORY"
  elif [[ "$dry_run" == true ]]; then
    printf '%s\n' '<current-consumer-repository>'
  else
    command -v gh >/dev/null 2>&1 || die 'gh is required to dispatch consumer workflows; pass --dry-run to preview'
    gh repo view --json nameWithOwner --jq .nameWithOwner
  fi
}

require_immutable_ref() {
  [[ "${values[infrastructure_ref]}" != main && "${values[infrastructure_ref]}" != master ]] ||
    die 'operational commands require an immutable infrastructure ref; use a release tag or commit SHA'
}

require_mutation_confirmation() {
  local expected="$1" answer
  [[ "$command_apply" == true ]] || die "mutating operation requires --apply --confirm $expected"
  if [[ "$command_confirm" != "$expected" && "$non_interactive" == true ]]; then
    die "--non-interactive mutating operation requires --confirm $expected"
  fi
  if [[ "$command_confirm" != "$expected" ]]; then
    printf 'Type %s to continue: ' "$expected" >&2
    IFS= read -r answer
    [[ "$answer" == "$expected" ]] || die 'confirmation did not match; operation cancelled'
  fi
}

confirm_state_bucket_creation() {
  local answer
  if [[ "$command_apply" == true ]]; then
    require_mutation_confirmation CREATE-STATE-BUCKET
    return 0
  fi
  if [[ "$automatic_state_bucket_bootstrap" == true && "$non_interactive" == false ]]; then
    printf 'Type CREATE-STATE-BUCKET to create and harden %s: ' "${values[aws.state_bucket]}" >&2
    IFS= read -r answer
    [[ "$answer" == CREATE-STATE-BUCKET ]] || die 'confirmation did not match; state bucket creation cancelled'
    return 0
  fi
  die 'mutating state-bucket setup requires --apply --confirm CREATE-STATE-BUCKET'
}

dispatch_workflow() {
  local workflow="$1" repo="$2" field run_args=()
  shift 2
  run_args=(workflow run "$workflow" --repo "$repo")
  while (($# > 0)); do
    field="$1"
    run_args+=(-f "$field")
    shift
  done
  if [[ "$dry_run" == true ]]; then
    printf 'would dispatch:'
    printf ' %q' gh "${run_args[@]}"
    printf '\n'
    return
  fi
  command -v gh >/dev/null 2>&1 || die 'gh is required to dispatch a consumer workflow'
  gh "${run_args[@]}"
  echo "dispatched $workflow in $repo"
  if [[ "$command_wait" == true ]]; then
    die '--wait is not supported because GitHub does not return a run ID from workflow dispatch'
  fi
}

parameters_adapter() {
  local environment repo
  environment="$(operational_environment)"
  require_immutable_ref
  [[ -n "$command_env_file" || -n "$command_clear_parameter" ]] ||
    die 'parameters requires --from-env-file or --clear-parameter'
  if [[ "$command_apply" == true ]]; then
    require_mutation_confirmation "PARAMETERS-${environment^^}"
  fi
  if [[ -n "$command_env_file" ]]; then
    [[ -x "$script_directory/bootstrap-backend-parameters" ]] ||
      die 'this remote wrapper cannot read local parameter files; use the generated parameters workflow with RUNTIME_PARAMETERS'
    local parameter_args=(
      --environment "$environment"
      --application-name "${values[application_name]}"
      --parameter-path "${values[backend.ssm_parameters_path]}"
      --from-env-file "$command_env_file"
    )
    local parameter
    for parameter in "${command_non_secret_parameters[@]}"; do parameter_args+=(--non-secret "$parameter"); done
    [[ "$command_allow_type_change" == true ]] && parameter_args+=(--allow-type-change)
    [[ "$command_apply" == true ]] && parameter_args+=(--apply)
    AWS_REGION="${values[aws.region]}" "$script_directory/bootstrap-backend-parameters" "${parameter_args[@]}"
    return
  fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-parameters.yml "$repo" \
    "environment=$environment" \
    "apply=$command_apply" \
    "clear_parameter=$command_clear_parameter"
}

infrastructure_adapter() {
  local environment repo apply_value
  environment="$(operational_environment)"
  require_immutable_ref
  if [[ "$command_name" == apply ]]; then
    require_mutation_confirmation "APPLY-${environment^^}"
    apply_value=true
  else
    apply_value=false
  fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-infra.yml "$repo" \
    "environment=$environment" "apply=$apply_value"
}

release_adapter() {
  local environment repo supplemental=''
  environment="$(operational_environment)"
  require_immutable_ref
  require_mutation_confirmation "RELEASE-${environment^^}"
  repo="$(consumer_repository)"
  if ((${#command_supplemental_files[@]} > 0)); then
    supplemental="$(IFS=,; printf '%s' "${command_supplemental_files[*]}")"
  fi
  dispatch_workflow poorman-aws-backend-deploy.yml "$repo" \
    "environment=$environment" "supplemental_files=$supplemental"
}

rollback_adapter() {
  local environment repo
  environment="$(operational_environment)"
  require_immutable_ref
  [[ "$command_release_id" =~ ^[0-9a-f]{7,64}$ ]] ||
    die 'rollback requires --release-id with a hexadecimal release identifier'
  require_mutation_confirmation "ROLLBACK-${environment^^}"
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-rollback.yml "$repo" \
    "environment=$environment" "release_id=$command_release_id"
}

ami_adapter() {
  local repo
  require_immutable_ref
  command_subnet_id="${command_subnet_id:-${values[ami.subnet_id]}}"
  command_ami_name_prefix="${command_ami_name_prefix:-${values[ami.name_prefix]}}"
  [[ -n "$command_subnet_id" ]] || die 'ami build requires --subnet-id'
  command_ami_name_prefix="${command_ami_name_prefix:-${values[application_name]}-backend}"
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-backend-ami.yml "$repo" \
    "subnet_id=$command_subnet_id" \
    "ami_name_prefix=$command_ami_name_prefix"
}

github_environment_sync() {
  local repo account role_prefix environment role_arn ami_role_arn
  command -v gh >/dev/null 2>&1 || die 'gh is required to synchronize GitHub environments'
  gh auth status >/dev/null 2>&1 ||
    die 'GitHub CLI authentication is required; run gh auth login with repository administration permission'
  repo="$(consumer_repository)"
  if [[ -z "$detected_aws_account" ]]; then
    command -v aws >/dev/null 2>&1 || die 'aws is required to derive the environment role ARNs'
    detected_aws_account="$(aws sts get-caller-identity --region "${values[aws.region]}" --query Account --output text 2>/dev/null || true)"
  fi
  [[ "$detected_aws_account" =~ ^[0-9]{12}$ ]] || die 'could not determine the AWS account ID for environment role synchronization'
  require_mutation_confirmation SYNC-GITHUB-ENVIRONMENTS
  role_prefix="${values[application_name]}-github"
  ami_role_arn="arn:aws:iam::${detected_aws_account}:role/${role_prefix}-ami-build"
  for environment in staging production ami-build; do
    role_arn="arn:aws:iam::${detected_aws_account}:role/${role_prefix}-${environment}"
    if [[ "$dry_run" == true ]]; then
      echo "would ensure GitHub environment: $environment"
      echo "would set secret: $environment/AWS_ROLE_ARN"
      if [[ "$environment" != ami-build ]]; then
        echo "would set secret: $environment/AWS_AMI_ROLE_ARN"
      fi
    else
      gh api --method PUT "repos/${repo}/environments/${environment}" >/dev/null
      printf '%s' "$role_arn" | gh secret set AWS_ROLE_ARN --env "$environment" --repo "$repo" >/dev/null
      if [[ "$environment" != ami-build ]]; then
        printf '%s' "$ami_role_arn" | gh secret set AWS_AMI_ROLE_ARN --env "$environment" --repo "$repo" >/dev/null
      fi
      echo "synchronized GitHub environment: $environment"
    fi
  done
  if [[ "${values[deployment_shape]}" != backend-only ]]; then
    for environment in staging production; do
      role_arn="arn:aws:iam::${detected_aws_account}:role/${role_prefix}-frontend-${environment}"
      if [[ "$dry_run" == true ]]; then
        echo "would set secret: $environment/AWS_FRONTEND_ROLE_ARN"
      else
        printf '%s' "$role_arn" | gh secret set AWS_FRONTEND_ROLE_ARN --env "$environment" --repo "$repo" >/dev/null
      fi
    done
  fi
}

lifecycle_adapter() {
  local environment repo action
  environment="$(operational_environment)"
  [[ "$environment" == staging ]] || die 'lifecycle is restricted to staging'
  require_immutable_ref
  action="${command_action:-${command_args[0]:-}}"
  [[ "$action" =~ ^(STOP|DESTROY|NUKE)$ ]] || die 'lifecycle requires --action STOP|DESTROY|NUKE'
  if [[ "$command_apply" == true ]]; then require_mutation_confirmation "${action}-STAGING"; fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-lifecycle.yml "$repo" \
    "action=$action" "confirmation=$command_confirm" "apply=$command_apply"
}

frontend_environment() {
  local environment="${command_environment:-staging}"
  [[ "$environment" =~ ^(staging|production)$ ]] || die '--environment must be staging or production'
  printf '%s\n' "$environment"
}

require_frontend_contract() {
  [[ -n "${values[frontend.directory]}" ]] || die 'frontend.directory is required'
  [[ -n "${values[frontend.build_command]}" && -n "${values[frontend.deploy_command]}" ]] ||
    die 'frontend build and deploy commands are required'
  [[ -n "${values[frontend.aws_role_secret]}" ]] || die 'frontend.aws_role_secret is required'
}

require_consumer_ref() {
  [[ -n "$command_consumer_ref" && "$command_consumer_ref" != main && "$command_consumer_ref" != master && "$command_consumer_ref" != *' '* ]] ||
    die 'frontend rollback/lifecycle requires an immutable --consumer-ref'
}

frontend_deploy_adapter() {
  local environment repo
  environment="$(frontend_environment)"
  require_immutable_ref
  require_frontend_contract
  require_mutation_confirmation "FRONTEND-DEPLOY-${environment^^}"
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-frontend-deploy.yml "$repo" "environment=$environment"
}

frontend_rollback_adapter() {
  local environment repo
  environment="$(frontend_environment)"
  require_immutable_ref
  require_frontend_contract
  require_consumer_ref
  require_mutation_confirmation "FRONTEND-ROLLBACK-${environment^^}"
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-frontend-rollback.yml "$repo" \
    "environment=$environment" "consumer_ref=$command_consumer_ref"
}

frontend_lifecycle_adapter() {
  local repo action
  [[ "${command_environment:-staging}" == staging ]] || die 'frontend lifecycle is restricted to staging'
  require_immutable_ref
  require_frontend_contract
  [[ -n "${values[frontend.frontend_hostname]}" ]] || die 'frontend.frontend_hostname is required'
  action="${command_action:-${command_args[1]:-}}"
  [[ "$action" =~ ^(DESTROY|NUKE)$ ]] || die 'frontend lifecycle requires --action DESTROY|NUKE'
  require_consumer_ref
  if [[ "$command_apply" == true ]]; then require_mutation_confirmation "FRONTEND-${action}-STAGING"; fi
  repo="$(consumer_repository)"
  dispatch_workflow poorman-aws-frontend-lifecycle.yml "$repo" \
    "action=$action" "confirmation=$command_confirm" "apply=$command_apply" \
    "consumer_ref=$command_consumer_ref"
}

frontend_smoke_adapter() {
  local smoke_script
  [[ -n "${values[frontend.frontend_url]}" ]] || die 'frontend.frontend_url is required'
  [[ -n "${values[frontend.api_url]}" ]] || die 'frontend.api_url is required'
  export FRONTEND_URL="${values[frontend.frontend_url]}"
  export API_URL="${values[frontend.api_url]}"
  export FRONTEND_ORIGIN="${values[frontend.frontend_origin]}"
  [[ -n "$command_cors_path" ]] && export CORS_PATH="$command_cors_path"
  [[ -n "$command_websocket_path" ]] && export WEBSOCKET_PATH="$command_websocket_path"
  if [[ -n "$script_directory" && -x "$script_directory/frontend-live-smoke" ]]; then
    smoke_script="$script_directory/frontend-live-smoke"
    bash "$smoke_script"
  else
    require_immutable_ref
    command -v curl >/dev/null 2>&1 || die 'curl is required for piped frontend smoke checks'
    curl -fsSL "https://raw.githubusercontent.com/${values[infrastructure_repository]}/${values[infrastructure_ref]}/bin/frontend-live-smoke" |
      bash
  fi
}

operational_adapter() {
  case "$command_name" in
    parameters) parameters_adapter ;;
    plan|apply) infrastructure_adapter ;;
    release) release_adapter ;;
    rollback) rollback_adapter ;;
    lifecycle) lifecycle_adapter ;;
    frontend)
      case "${command_args[0]:-}" in
        deploy) frontend_deploy_adapter ;;
        rollback) frontend_rollback_adapter ;;
        lifecycle) frontend_lifecycle_adapter ;;
        smoke) frontend_smoke_adapter ;;
        *) die 'usage: frontend deploy|rollback|lifecycle|smoke' ;;
      esac ;;
    ami)
      [[ "${command_args[0]:-build}" == build ]] || die 'usage: ami build'
      ami_adapter ;;
    github)
      [[ "${command_args[0]:-}" == sync ]] || die 'usage: github sync'
      github_environment_sync ;;
    *) die "unsupported operational command: $command_name" ;;
  esac
}

doctor_failure=0

doctor_fail() {
  echo "missing: $1" >&2
  echo "hint: $2" >&2
  doctor_failure=1
}

doctor_command() {
  local name="$1" hint="$2"
  if command -v "$name" >/dev/null 2>&1; then
    echo "ok: $name ($(command -v "$name"))"
  else
    doctor_fail "$name" "$hint"
  fi
}

consumer_path() {
  local configured_path="$1"
  if [[ "$configured_path" == /* ]]; then
    printf '%s\n' "$configured_path"
  else
    printf '%s/%s\n' "$PWD" "$configured_path"
  fi
}

doctor_file() {
  local label="$1" path="$2" hint="$3"
  if [[ -f "$path" ]]; then
    echo "ok: $label ($path)"
  else
    doctor_fail "$label ($path)" "$hint"
  fi
}

doctor_directory() {
  local label="$1" path="$2" hint="$3"
  if [[ -d "$path" ]]; then
    echo "ok: $label ($path)"
  else
    doctor_fail "$label ($path)" "$hint"
  fi
}

doctor_resolve_file() {
  local label="$1" option="$2" configured="$3" candidate
  shift 3
  if [[ -f "$configured" ]]; then
    printf '%s\n' "$configured"
    return
  fi
  for candidate in "$@"; do
    if [[ -f "$PWD/$candidate" ]]; then
      echo "hint: detected $label at $PWD/$candidate; use --$option to make this explicit" >&2
      printf '%s\n' "$PWD/$candidate"
      return
    fi
  done
  printf '%s\n' "$configured"
}

doctor_consumer_contract() {
  local compose_file caddy_file dockerfile build_context
  compose_file="$(doctor_resolve_file 'Compose file' compose-file "$(consumer_path "${values[backend.compose_file]}")" \
    deployment/backend/compose.production.yaml backend/compose.production.yaml compose.yaml)"
  caddy_file="$(doctor_resolve_file Caddyfile caddy-file "$(consumer_path "${values[backend.caddy_file]}")" \
    deployment/backend/Caddyfile backend/Caddyfile Caddyfile)"
  dockerfile="$(doctor_resolve_file Dockerfile dockerfile "$(consumer_path "${values[backend.dockerfile]}")" \
    backend/Dockerfile Dockerfile)"
  build_context="$(consumer_path "${values[backend.build_context]}")"
  doctor_file 'Compose file' "$compose_file" \
    'set backend.compose_file to the consumer-owned Compose path'
  doctor_file 'Caddyfile' "$caddy_file" \
    'set backend.caddy_file to the consumer-owned reverse-proxy configuration'
  doctor_file 'Dockerfile' "$dockerfile" \
    'set backend.dockerfile to the application image Dockerfile'
  doctor_directory 'Docker build context' "$build_context" \
    'set backend.build_context to the application image build directory'

  if [[ -z "${values[aws.state_bucket]-}" ]]; then
    doctor_fail 'aws.state_bucket' \
      'set the encrypted remote OpenTofu state bucket in YAML or with --state-bucket'
    echo 'next: run bootstrap state-bucket to create or verify the remote state bucket' >&2
  else
    echo "ok: aws.state_bucket (${values[aws.state_bucket]})"
  fi
}

doctor_docker() {
  local compose_file
  doctor_command docker 'install Docker Desktop or Docker Engine with Compose v2'
  if ! command -v docker >/dev/null 2>&1; then return; fi
  if docker compose version >/dev/null 2>&1; then
    echo "ok: docker compose ($(docker compose version --short 2>/dev/null || echo available))"
  else
    doctor_fail 'docker compose' 'install or enable the Docker Compose v2 plugin'
    return
  fi
  compose_file="$(consumer_path "${values[backend.compose_file]}")"
  if [[ -f "$compose_file" ]] && docker compose -f "$compose_file" config --quiet >/dev/null 2>&1; then
    echo "ok: Compose configuration parses ($compose_file)"
  elif [[ -f "$compose_file" ]]; then
    doctor_fail 'Compose configuration' \
      'run docker compose config with the consumer runtime environment and fix interpolation or syntax errors'
  fi
}

doctor_aws() {
  local identity account
  doctor_command aws 'install AWS CLI v2 and configure an allowed identity'
  if ! command -v aws >/dev/null 2>&1; then return; fi
  identity="$(aws sts get-caller-identity --region "${values[aws.region]}" --output json 2>/dev/null || true)"
  account="$(jq -r '.Account // empty' <<<"$identity" 2>/dev/null || true)"
  if [[ "$account" =~ ^[0-9]{12}$ ]]; then
    detected_aws_account="$account"
    detected_aws_caller="$(jq -r '.Arn // empty' <<<"$identity" 2>/dev/null || true)"
    echo "ok: AWS identity (account $account, region ${values[aws.region]})"
  else
    doctor_fail 'AWS identity' \
      'authenticate AWS CLI with an identity permitted to inspect the configured environment'
  fi
}

doctor_github() {
  doctor_command gh 'install GitHub CLI and run gh auth login'
  if ! command -v gh >/dev/null 2>&1; then return; fi
  if gh auth status >/dev/null 2>&1; then
    echo 'ok: GitHub CLI authentication'
  else
    doctor_fail 'GitHub CLI authentication' 'run gh auth login with a token allowed to manage the requested repository'
  fi
}

install_aws_auth() {
  local identity account answer
  doctor_command aws 'install AWS CLI v2; prefer AWS IAM Identity Center (SSO) for local authentication'
  command -v aws >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  identity="$(aws sts get-caller-identity --region "${values[aws.region]}" --output json 2>/dev/null || true)"
  account="$(jq -r '.Account // empty' <<<"$identity" 2>/dev/null || true)"
  if [[ "$account" =~ ^[0-9]{12}$ ]]; then
    detected_aws_account="$account"
    detected_aws_caller="$(jq -r '.Arn // empty' <<<"$identity" 2>/dev/null || true)"
    echo "ok: AWS identity (account $account, region ${values[aws.region]})"
    return 0
  fi
  if [[ "$dry_run" == true ]]; then
    echo 'would offer: aws configure sso'
  elif [[ "$setup_auth" == true && "$non_interactive" == false ]]; then
    printf 'AWS authentication is unavailable. Run "aws configure sso" now? [y/N]: ' >&2
    IFS= read -r answer
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      aws configure sso
      identity="$(aws sts get-caller-identity --region "${values[aws.region]}" --output json 2>/dev/null || true)"
      account="$(jq -r '.Account // empty' <<<"$identity" 2>/dev/null || true)"
      detected_aws_account="$account"
      detected_aws_caller="$(jq -r '.Arn // empty' <<<"$identity" 2>/dev/null || true)"
    fi
  fi
  if [[ "$account" =~ ^[0-9]{12}$ ]]; then
    detected_aws_account="$account"
    echo "ok: AWS identity (account $account, region ${values[aws.region]})"
  else
    doctor_fail 'AWS identity' \
      'run aws configure sso (recommended) or configure an allowed AWS profile, then rerun install'
  fi
}

prompt_install_application_name() {
  local suggestion answer
  if [[ "${sources[application_name]}" != default ]]; then
    echo "Application name: ${values[application_name]}"
    return 0
  fi
  suggestion="$(basename "$PWD" | tr '[:upper:]_' '[:lower:]-' | sed 's/[^a-z0-9-]/-/g; s/^-*//; s/-*$//')"
  [[ "$suggestion" =~ ^[a-z][a-z0-9-]{1,32}$ ]] || suggestion=application
  set_value application_name "$suggestion" detected
  if [[ "$non_interactive" == true || "$dry_run" == true ]]; then
    echo "Application name: $suggestion"
    return 0
  fi
  printf 'Application name [%s]: ' "$suggestion" >&2
  IFS= read -r answer
  if [[ -n "$answer" ]]; then
    set_value application_name "$answer" prompt
  fi
  validate_values
}

select_aws_profile() {
  local profiles suggested selected profile
  command -v aws >/dev/null 2>&1 || return 0
  if [[ -n "${AWS_PROFILE:-}" ]]; then
    if [[ "$update_install" == true ]]; then
      echo "AWS profile: $AWS_PROFILE (from AWS_PROFILE)"
    else
      echo "AWS profile: $AWS_PROFILE"
    fi
    return 0
  fi

  profiles="$(aws configure list-profiles 2>/dev/null || true)"
  suggested='default'
  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    if [[ "${profile,,}" == administrator ]]; then
      suggested="$profile"
      break
    fi
    if [[ "${profile,,}" == admin && "$suggested" == default ]]; then
      suggested="$profile"
    fi
  done <<<"$profiles"
  if [[ "$suggested" == default && -n "$profiles" ]]; then
    suggested="${profiles%%$'\n'*}"
  fi

  selected="$suggested"
  if [[ "$non_interactive" == false && "$dry_run" == false ]]; then
    printf 'AWS profile to use [%s]: ' "$suggested" >&2
    IFS= read -r selected
    selected="${selected:-$suggested}"
  fi
  if [[ -n "$profiles" ]] && ! grep -Fxq "$selected" <<<"$profiles"; then
    die "AWS profile not found: $selected"
  fi
  export AWS_PROFILE="$selected"
  echo "AWS profile: $AWS_PROFILE"
}

validate_aws_region() {
  local region="$1" available
  [[ "$region" =~ ^[a-z0-9-]+$ ]] || die "invalid AWS region: $region"
  available="$(aws ec2 describe-regions \
    --region us-east-1 \
    --all-regions \
    --query "Regions[?RegionName=='$region'].RegionName | [0]" \
    --output text 2>/dev/null || true)"
  [[ "$available" == "$region" ]] || die "AWS region is not available: $region"
}

select_aws_region() {
  local configured answer selected
  if [[ "${sources[aws.region]}" == default ]]; then
    configured="$(aws configure get region --profile "$AWS_PROFILE" 2>/dev/null || true)"
    if [[ -n "$configured" ]]; then
      set_value aws.region "$configured" profile
    elif [[ "$non_interactive" == true ]]; then
      die 'AWS profile has no region; set aws.region in YAML or pass --aws-region'
    else
      printf 'AWS region [%s]: ' "${values[aws.region]}" >&2
      IFS= read -r answer
      selected="${answer:-${values[aws.region]}}"
      set_value aws.region "$selected" prompt
    fi
  fi
  validate_aws_region "${values[aws.region]}"
  aws configure --profile "$AWS_PROFILE" set region "${values[aws.region]}"
  echo "AWS region: ${values[aws.region]}"
  validate_values
}

check_aws_setup_privileges() {
  local simulation action decision
  local -a actions=(
    s3:CreateBucket
    s3:PutBucketVersioning
    s3:PutBucketEncryption
    s3:PutPublicAccessBlock
    iam:CreateOpenIDConnectProvider
    iam:GetOpenIDConnectProvider
    iam:CreateRole
    iam:PutRolePolicy
    iam:AttachRolePolicy
    route53:ListHostedZonesByName
    route53:ChangeResourceRecordSets
  )

  [[ -n "$detected_aws_caller" ]] || {
    doctor_fail 'AWS setup authorization' \
      'AWS caller identity is unavailable; authenticate an administrator-capable profile'
    return
  }

  echo 'AWS setup authorization (read-only IAM simulation):'
  simulation="$(aws iam simulate-principal-policy \
    --policy-source-arn "$detected_aws_caller" \
    --action-names "${actions[@]}" \
    --output json 2>/dev/null || true)"
  if [[ -z "$simulation" ]]; then
    aws_setup_privileges=unknown
    doctor_fail 'AWS setup authorization' \
      'IAM policy simulation was unavailable; use a profile allowed to simulate its effective policy or review the required setup permissions manually'
    return
  fi

  aws_setup_privileges=passed
  while IFS=$'\t' read -r action decision; do
    [[ -n "$action" ]] || continue
    if [[ "$decision" == allowed ]]; then
      echo "ok: $action"
    else
      aws_setup_privileges=failed
      echo "missing: $action ($decision)" >&2
      doctor_failure=1
    fi
  done < <(jq -r '.EvaluationResults[] | [.EvalActionName, .EvalDecision] | @tsv' <<<"$simulation")

  for action in "${actions[@]}"; do
    if ! jq -e --arg action "$action" '.EvaluationResults[] | select(.EvalActionName == $action)' \
      <<<"$simulation" >/dev/null; then
      aws_setup_privileges=unknown
      doctor_fail "AWS setup authorization: $action" 'IAM simulation returned no decision for this required action'
    fi
  done
}

install_github_auth() {
  local answer
  doctor_command gh 'install GitHub CLI and run gh auth login'
  command -v gh >/dev/null 2>&1 || return 0
  if gh auth status >/dev/null 2>&1; then
    echo 'ok: GitHub CLI authentication'
    return 0
  fi
  if [[ "$dry_run" == true ]]; then
    echo 'would offer: gh auth login'
  elif [[ "$setup_auth" == true && "$non_interactive" == false ]]; then
    printf 'GitHub CLI is not authenticated. Run "gh auth login" now? [y/N]: ' >&2
    IFS= read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] && gh auth login
  fi
  if gh auth status >/dev/null 2>&1; then
    echo 'ok: GitHub CLI authentication'
  else
    doctor_fail 'GitHub CLI authentication' \
      'run gh auth login with permission to manage the consumer repository, then rerun install'
  fi
}

install_command() {
  restore_install_state
  prompt_install_application_name
  echo "state: $(write_install_state incomplete)"
  doctor_failure=0
  doctor_command bash 'install Bash 4+ or use the supported system package'
  doctor_command curl 'install curl for pinned raw-wrapper consumption'
  doctor_command jq 'install jq for structured AWS and workflow output'
  doctor_command git 'install Git and run this command from the consumer repository'
  if (command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1) ||
     (command -v ruby >/dev/null 2>&1 && ruby -e 'require "yaml"' >/dev/null 2>&1); then
    echo 'ok: YAML parser (Python PyYAML or Ruby Psych)'
  else
    doctor_fail 'YAML parser' 'install Python 3 with PyYAML or Ruby with Psych'
  fi

  if [[ "$offline" == true ]]; then
    echo 'info: offline mode skips AWS and GitHub authentication checks'
  else
    select_aws_profile
    select_aws_region
    install_aws_auth
  if [[ -z "${values[aws.state_bucket]-}" ]]; then
    if [[ "$aws_setup_privileges" == passed && "$update_install" != true ]]; then
      echo 'AWS setup authorization: passed (saved installer state)'
    else
      check_aws_setup_privileges
    fi
    if [[ -z "${values[aws.state_bucket]-}" && "$aws_setup_privileges" == passed && "$doctor_failure" -eq 0 ]]; then
      echo 'next: guided setup will create and harden the remote OpenTofu state bucket'
      automatic_state_bucket_bootstrap=true
      bootstrap_state_bucket
      automatic_state_bucket_bootstrap=false
    fi
    fi
    install_github_auth
  fi
  echo "state: $(write_install_state incomplete)"
  doctor_consumer_contract
  if [[ "$check_docker" == true ]]; then doctor_docker; fi
  if [[ "$check_infra" == true ]]; then
    doctor_command tofu 'install OpenTofu for infrastructure planning'
  fi
  if [[ "$check_ami" == true ]]; then
    doctor_command packer 'install Packer for reviewed host AMI builds'
    doctor_command zstd 'install zstd for release and AMI artifact compression'
  fi
  [[ "$doctor_failure" -eq 0 ]] || die 'installation checks failed; follow the remediation hints and rerun install'
  echo 'installation checks passed'
  echo "state: $(write_install_state passed)"
  if [[ "$non_interactive" == false && "$dry_run" == false && -t 0 ]]; then
    local answer
    printf 'Continue to onboarding now? [Y/n]: ' >&2
    IFS= read -r answer
    if [[ ! "$answer" =~ ^[Nn]$ ]]; then
      onboard
    else
      echo 'paused after installation; continue with the fast path: bin/poorman-aws onboard'
      echo 'to rerun the full installation checks: bin/poorman-aws install'
    fi
  else
    local command_path consumer_argument
    command_path="$(printf '%q' "$(wrapper_command)")"
    consumer_argument="$(printf '%q' "$consumer_root")"
    echo 'next: run onboard to generate the consumer GitHub Actions workflow integration files:'
    echo "  $command_path --consumer-path $consumer_argument onboard"
    echo 'next: then, when online, synchronize GitHub environments:'
    echo "  $command_path --consumer-path $consumer_argument --apply --confirm SYNC-GITHUB-ENVIRONMENTS github sync"
    echo 'next: verify prerequisites:'
    echo "  $command_path --consumer-path $consumer_argument --aws --github --docker --infra doctor"
  fi
}

persist_state_bucket_config() {
  local existing_config=''
  if [[ "$config_explicit" == true || -f .poorman-aws.yml || -f .poorman-aws.yaml ]]; then
    if [[ -f .poorman-aws.yml ]]; then
      existing_config=.poorman-aws.yml
    elif [[ -f .poorman-aws.yaml ]]; then
      existing_config=.poorman-aws.yaml
    fi
    [[ -z "$existing_config" ]] || persist_consumer_config_state "$existing_config"
    echo 'state bucket recorded in installer state; existing consumer configuration was not overwritten'
    return 0
  fi
  cat > .poorman-aws.yml <<EOF
version: 1
application_name: $(yaml_quote "${values[application_name]}")
aws:
  region: $(yaml_quote "${values[aws.region]}")
  state_bucket: $(yaml_quote "${values[aws.state_bucket]}")
EOF
  persist_consumer_config_state .poorman-aws.yml
  echo 'generated .poorman-aws.yml with the verified state bucket'
}

bootstrap_state_bucket() {
  local bucket suggested existing=false
  if [[ "$command_name" == bootstrap ]]; then
    [[ "${command_args[0]:-}" == state-bucket ]] || die 'usage: bootstrap state-bucket'
  fi
  restore_install_state
  prompt_install_application_name
  command -v aws >/dev/null 2>&1 || die 'aws CLI is required for state-bucket bootstrap'
  select_aws_profile
  select_aws_region
  doctor_failure=0
  install_aws_auth
  [[ "$doctor_failure" -eq 0 && -n "$detected_aws_account" ]] ||
    die 'AWS identity is required for state-bucket bootstrap'

  bucket="${values[aws.state_bucket]-}"
  if [[ -z "$bucket" ]]; then
    suggested="${values[application_name]}-tofu-state-${detected_aws_account}"
    if [[ "$non_interactive" == true ]]; then
      bucket="$suggested"
    else
      printf 'OpenTofu state bucket [%s]: ' "$suggested" >&2
      IFS= read -r bucket
      bucket="${bucket:-$suggested}"
    fi
    set_value aws.state_bucket "$bucket" prompt
  fi
  [[ "$bucket" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ ]] ||
    die 'state bucket must be a valid globally unique S3 bucket name'

  if aws s3api head-bucket --bucket "$bucket" >/dev/null 2>&1; then
    existing=true
    echo "state bucket exists: $bucket"
  else
    echo "state bucket missing: $bucket"
  fi

  if [[ "$existing" != true ]]; then
    if [[ "$dry_run" == true ]]; then
      echo "would create and harden state bucket: $bucket"
      echo 're-run with --apply --confirm CREATE-STATE-BUCKET to create it'
      return 0
    fi
    confirm_state_bucket_creation
    if [[ "${values[aws.region]}" == us-east-1 ]]; then
      aws s3api create-bucket --bucket "$bucket" --region "${values[aws.region]}"
    else
      aws s3api create-bucket --bucket "$bucket" --region "${values[aws.region]}" \
        --create-bucket-configuration "LocationConstraint=${values[aws.region]}"
    fi
    aws s3api put-public-access-block --bucket "$bucket" \
      --public-access-block-configuration \
      BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
    aws s3api put-bucket-versioning --bucket "$bucket" \
      --versioning-configuration Status=Enabled
    aws s3api put-bucket-encryption --bucket "$bucket" \
      --server-side-encryption-configuration \
      '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]}'
  fi

  if [[ "$dry_run" == true ]]; then
    echo "would verify state bucket encryption, versioning, and public-access blocking"
    return 0
  fi
  aws s3api get-bucket-versioning --bucket "$bucket" >/dev/null
  aws s3api get-bucket-encryption --bucket "$bucket" >/dev/null
  aws s3api get-public-access-block --bucket "$bucket" >/dev/null
  set_value aws.state_bucket "$bucket" bootstrap
  write_install_state passed bootstrap-state-bucket >/dev/null
  persist_state_bucket_config
  echo "verified state bucket: $bucket"
}

doctor() {
  doctor_failure=0
  doctor_command bash 'install Bash 4+ (or use the supported system package)'
  doctor_command curl 'install curl for remote wrapper and AWS endpoint checks'
  doctor_command jq 'install jq for structured AWS and policy output'
  doctor_command git 'install Git and run this command from the consumer repository'
  if (command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1) ||
     (command -v ruby >/dev/null 2>&1 && ruby -e 'require "yaml"' >/dev/null 2>&1); then
    echo 'ok: YAML parser (Python PyYAML or Ruby Psych)'
  else
    doctor_fail 'YAML parser' 'install Python 3 with PyYAML or Ruby with Psych'
  fi
  doctor_consumer_contract

  if [[ "$offline" != true ]]; then
    if [[ "$check_aws" == true ]]; then doctor_aws; fi
    if [[ "$check_github" == true ]]; then doctor_github; fi
  else
    echo 'info: offline mode skips AWS and GitHub checks'
  fi
  if [[ "$check_docker" == true ]]; then doctor_docker; fi
  if [[ "$check_infra" == true ]]; then
    doctor_command tofu 'install OpenTofu for infrastructure planning'
  fi
  if [[ "$check_ami" == true ]]; then
    doctor_command packer 'install Packer for reviewed host AMI builds'
    doctor_command zstd 'install zstd for release and AMI artifact compression'
  fi
  [[ "$doctor_failure" -eq 0 ]]
}

reserved_command() {
  warn "command '$*' is defined by the Phase 0 contract but not implemented yet"
  warn 'use config validate/show or doctor; later phases add the operational adapter'
  exit 3
}

main() {
  parse_args "$@"
  # no-op that evaluates variables without executing them as commands to silence shellcheck's warnings
  : "$non_interactive" "$dry_run"
  resolve_consumer_root
  case "$command_name" in
    install|onboard) prompt_consumer_root ;;
  esac
  load_defaults
  load_config
  apply_cli_values
  validate_values
  case "$command_name" in
    install) install_command ;;
    bootstrap) bootstrap_state_bucket ;;
    config)
      case "${command_args[0]:-}" in
        validate) echo 'configuration valid' ;;
        show) show_config ;;
        *) die 'usage: config validate|show' ;;
      esac ;;
    doctor) doctor ;;
    onboard) onboard ;;
    parameters|ami|plan|apply|release|rollback|lifecycle|frontend|github)
      operational_adapter ;;
    help) usage ;;
    *) die "unknown command: $command_name" ;;
  esac
}

main "$@"
