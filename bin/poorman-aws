      apply: ${{ inputs.apply }}
      aws_region: __REGION__
      frontend_hostname: ${{ vars.FRONTEND_HOSTNAME || '__FRONTEND_HOSTNAME__' }}
      frontend_directory: __FRONTEND_DIRECTORY__
      frontend_remove_command: __FRONTEND_REMOVE_COMMAND__
      consumer_ref: ${{ inputs.consumer_ref }}
    secrets:
      aws_role_arn: ${{ secrets.__FRONTEND_ROLE_SECRET__ }}
