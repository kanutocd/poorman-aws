#!/usr/bin/env bash
set -euo pipefail

wrapper_source="${BASH_SOURCE[0]-}"
if [[ -n "$wrapper_source" && "$wrapper_source" != /dev/stdin && "$wrapper_source" != bash ]]; then
  script_directory="$(cd "$(dirname "$wrapper_source")" && pwd)"
else
  script_directory=''
fi

wrapper_command() {
  if [[ -n "$wrapper_source" && "$wrapper_source" != /dev/stdin && "$wrapper_source" != bash ]]; then
    printf '%s\n' "$wrapper_source"
  else
    printf 'poorman-aws\n'
  fi
}

# Self-contained consumer entry point. It is intentionally safe:
# operational commands are reserved until their adapters are implemented.

declare -A values sources cli_values
config_path=''
consumer_path_option=''
consumer_root=''
consumer_root_source='none'
config_explicit=false
json_output=false
non_interactive=false
dry_run=false
overwrite=false
offline=false
check_aws=false
check_docker=false
check_infra=false
check_ami=false
check_github=false
setup_auth=false
update_install=false
automatic_state_bucket_bootstrap=false
detected_aws_account=''
detected_aws_caller=''
aws_setup_privileges='not_checked'
command_name=''
command_args=()
command_environment=''
command_apply=false
command_confirm=''
command_repo=''
command_release_id=''
command_action=''
command_subnet_id=''
command_ami_name_prefix=''
command_wait=false
command_env_file=''
command_clear_parameter=''
command_non_secret_parameters=()
command_allow_type_change=false
command_supplemental_files=()
command_consumer_ref=''
command_cors_path=''
command_websocket_path=''
# The wrapper release owns the default immutable ref used by generated callers.
# package-wrapper rewrites this value when producing a versioned artifact.
wrapper_release_ref='v0.1.0'

usage() {
  cat <<'EOF'
Usage: poorman-aws [global options] COMMAND [command options]

Commands:
  install               Check prerequisites and guide first-run setup.
  bootstrap state-bucket Create or verify the remote OpenTofu state bucket.
  config validate       Validate effective configuration.
  config show           Show effective redacted configuration.
  doctor                Check prerequisites and the consumer repository contract.
  onboard               Generate consumer config and thin caller workflows.
  parameters|ami build  Manage runtime parameters or build a reviewed AMI.
  plan|apply             Dispatch a protected infrastructure plan or apply.
  release|rollback      Dispatch an immutable backend release operation.
  lifecycle              Dispatch guarded non-production lifecycle operations.
  frontend deploy       Dispatch the consumer frontend deployment workflow.
  frontend rollback     Dispatch a known-good frontend rollback.
  frontend lifecycle    Dispatch guarded non-production frontend lifecycle.
  frontend smoke        Run non-mutating frontend/API acceptance checks.
  github sync           Create consumer environments and synchronize AWS role secrets.

Global options:
  --config PATH         Explicit YAML configuration file.
  --consumer-path PATH  Consumer repository root (default: detected Git root).
  --non-interactive     Refuse prompts.
  --json                Emit machine-readable output where supported.
  --dry-run             Never mutate files or call mutating operations.
  --overwrite           Allow replacing generated files after conflict checks.
  --offline             Skip AWS/GitHub checks and network-backed onboarding inference.
  --aws                 Check AWS CLI identity and configured region.
  --docker              Check Docker Compose and the consumer Compose file.
  --infra               Check OpenTofu and infrastructure prerequisites.
  --ami                 Check Packer and AMI-build prerequisites.
  --github              Check GitHub CLI authentication.
  --setup-auth          Offer interactive AWS SSO and GitHub authentication.
  --update              Revisit saved installer values interactively.
  --deployment-shape    Set backend-and-frontend, backend-only, or frontend-only.
  --target-environment  Set the generated workflow default to staging or production.
  Frontend options: --frontend-directory, --build-command, --deploy-command,
  --remove-command, --output-entrypoint, --frontend-url, --api-url,
  --frontend-origin, --api-base-url, --frontend-hostname,
  --frontend-certificate-arn, --consumer-ref, --cors-path, --websocket-path.
  AMI options: --ami-subnet-id, --ami-name-prefix.
  Operational options are accepted after the command; use --help with a
  command in a consumer repository for the required values.
  --help, --version

Precedence: built-in defaults < YAML configuration < command-line options.
EOF
}

die() { echo "poorman-aws: $*" >&2; exit 2; }
warn() { echo "poorman-aws: warning: $*" >&2; }

expand_user_path() {
  local user user_home user_path
  case "$1" in
    \~) printf '%s\n' "${HOME:-}" ;;
    \~/*) printf '%s/%s\n' "${HOME:-}" "${1#\~/}" ;;
    \~[!/]*)
      user_path="${1#\~}"
      user="${user_path%%/*}"
      user_home="$(getent passwd "$user" 2>/dev/null | cut -d: -f6)"
      if [[ -n "$user_home" ]]; then
        if [[ "$user_path" == */* ]]; then
          printf '%s/%s\n' "$user_home" "${user_path#*/}"
        else
          printf '%s\n' "$user_home"
        fi
      else
        printf '%s\n' "$1"
      fi
      ;;
    *) printf '%s\n' "$1" ;;
  esac
}

state_directory() {
  printf '%s/poorman-aws\n' "${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}"
}

resolve_consumer_root() {
  local candidate config_directory expanded_consumer_path
  if [[ -n "$consumer_path_option" ]]; then
    expanded_consumer_path="$(expand_user_path "$consumer_path_option")"
    [[ -d "$expanded_consumer_path" ]] || die "consumer path is not a directory: $consumer_path_option"
    consumer_root="$(cd "$expanded_consumer_path" && pwd -P)"
    consumer_root_source='explicit'
  elif [[ -n "$config_path" && "$config_path" != /* ]]; then
    config_directory="$(cd "$(dirname "$config_path")" && pwd -P)"
    consumer_root="$config_directory"
    consumer_root_source='inferred'
  elif [[ -n "$config_path" ]]; then
    consumer_root="$(cd "$(dirname "$config_path")" && pwd -P)"
    consumer_root_source='inferred'
  elif [[ -n "$script_directory" && "$(basename "$(dirname "$script_directory")")" == .poorman-aws ]]; then
    consumer_root="$(cd "$script_directory/../.." && pwd -P)"
    consumer_root_source='inferred'
  elif candidate="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)" && [[ -n "$candidate" ]]; then
    consumer_root="$candidate"
    consumer_root_source='inferred'
  elif [[ -e "$PWD/.poorman-aws.yml" || -e "$PWD/.poorman-aws.yaml" ||
    -d "$PWD/.git" || -d "$PWD/backend" || -d "$PWD/frontend" ||
    -d "$PWD/deployment" ]]; then
    consumer_root="$PWD"
    consumer_root_source='inferred'
  else
    consumer_root=''
  fi
  [[ -z "$consumer_root" ]] || cd "$consumer_root"
}

prompt_consumer_root() {
  local answer selected expanded_selected
  if [[ "$consumer_root_source" == explicit ]]; then
    return 0
  fi
  if [[ -n "$consumer_root" && ! -t 0 ]]; then
    return 0
  fi
  if [[ "$non_interactive" == true ]]; then
    [[ -n "$consumer_root" ]] ||
      die 'consumer repository path could not be inferred; provide --consumer-path PATH'
    return 0
  fi
  if [[ -n "$consumer_root" ]]; then
    printf 'Consumer repository path [%s]: ' "$consumer_root" >&2
  else
    printf 'Consumer repository path: ' >&2
  fi
  IFS= read -r answer || die 'unable to read the consumer repository path'
  selected="${answer:-$consumer_root}"
  [[ -n "$selected" ]] || die 'consumer repository path is required'
  expanded_selected="$(expand_user_path "$selected")"
  [[ -d "$expanded_selected" ]] || die "consumer repository path is not a directory: $selected"
  consumer_root="$(cd "$expanded_selected" && pwd -P)"
  consumer_root_source='prompt'
  cd "$consumer_root"
}

consumer_state_file() {
  local consumer_key
  consumer_key="$(printf '%s' "$PWD" | sha256sum | cut -c1-16)"
  printf '%s/consumer-%s.yml\n' "$(state_directory)" "$consumer_key"
}

consumer_config_state_file() {
  local consumer_key
  consumer_key="$(printf '%s' "$PWD" | sha256sum | cut -c1-16)"
  printf '%s/consumer-%s.config.yml\n' "$(state_directory)" "$consumer_key"
}

persist_consumer_config_state() {
  local source_path="${1:-.poorman-aws.yml}" target_path
  [[ -f "$source_path" ]] || return 0
  target_path="$(consumer_config_state_file)"
  mkdir -p "$(state_directory)"
  cp "$source_path" "$target_path"
  chmod 600 "$target_path"
  echo "persisted consumer configuration checkpoint: $target_path"
}

yaml_quote() {
  local value="$1"
  value="${value//\'/\'\'}"
  printf "'%s'" "$value"
}

saved_state_value() {
  local key="$1" state_file value
  state_file="$(consumer_state_file)"
  [[ -r "$state_file" ]] || return 0
  value="$(sed -n "s/^${key}: '\(.*\)'$/\1/p" "$state_file" | head -1)"
  printf '%s\n' "$value"
}

restore_install_state() {
  local saved_application saved_profile saved_region saved_state_bucket saved_privileges
  [[ "$update_install" == true ]] && return 0
  saved_application="$(saved_state_value application_name)"
  if [[ "${sources[application_name]}" == default && -n "$saved_application" ]]; then
    set_value application_name "$saved_application" state
  fi
  if [[ -z "${AWS_PROFILE:-}" ]]; then
    saved_profile="$(saved_state_value aws_profile)"
    if [[ -n "$saved_profile" ]]; then
      export AWS_PROFILE="$saved_profile"
    fi
  fi
saved_region="$(saved_state_value aws_region)"
  if [[ "${sources[aws.region]}" == default && -n "$saved_region" ]]; then
    set_value aws.region "$saved_region" state
  fi
  saved_state_bucket="$(saved_state_value aws_state_bucket)"
  if [[ "${sources[aws.state_bucket]-default}" == default && -n "$saved_state_bucket" ]]; then
    set_value aws.state_bucket "$saved_state_bucket" state
  fi
  saved_privileges="$(saved_state_value aws_setup_privileges)"
  if [[ -n "$saved_privileges" ]]; then
    aws_setup_privileges="$saved_privileges"
  fi
}

write_install_state() {
  local result="${1:-incomplete}" command="${2:-install}" state_dir state_file temporary_file profile
  state_dir="$(state_directory)"
  state_file="$(consumer_state_file)"
  profile="${AWS_PROFILE:-default}"
  mkdir -p "$state_dir"
  temporary_file="$(mktemp "$state_dir/.consumer-state.XXXXXX")"
  chmod 600 "$temporary_file"
  cat >"$temporary_file" <<EOF
consumer_path: $(yaml_quote "$PWD")
application_name: $(yaml_quote "${values[application_name]}")
aws_account_id: $(yaml_quote "${detected_aws_account}")
aws_caller_arn: $(yaml_quote "${detected_aws_caller}")
aws_profile: $(yaml_quote "$profile")
aws_region: $(yaml_quote "${values[aws.region]}")
aws_state_bucket: $(yaml_quote "${values[aws.state_bucket]-}")
aws_setup_privileges: $(yaml_quote "$aws_setup_privileges")
last_command: $(yaml_quote "$command")
last_result: $(yaml_quote "$result")
EOF
  mv "$temporary_file" "$state_file"
  printf '%s\n' "$state_file"
}

allowed_key() {
  case "$1" in
    version|application_name|deployment_shape|infrastructure_repository|infrastructure_ref|\
    aws.region|aws.state_bucket|aws.availability_zone|aws.route53_zone_name|\
    aws.route53_zone_id|ami.subnet_id|ami.ssh_cidr|ami.name_prefix|\
    backend.ssm_parameters_path|backend.compose_file|\
    backend.caddy_file|backend.build_context|backend.dockerfile|\
    backend.supplemental_files|defaults.target_environment|defaults.instance_type|defaults.root_volume_size_gib|\
    defaults.data_volume_size_gib|defaults.release_retention_days|\
    defaults.enable_data_volume_backups|defaults.backup_kms_key_arn|\
    defaults.retain_data_volume|defaults.retain_eip|frontend.directory|\
    frontend.build_command|frontend.deploy_command|frontend.remove_command|\
    frontend.output_entrypoint|frontend.frontend_url|frontend.api_url|\
    frontend.frontend_origin|frontend.api_base_url|frontend.frontend_hostname|\
    frontend.frontend_certificate_arn|frontend.aws_role_secret)
      return 0 ;;
    *) return 1 ;;
  esac
}

set_value() {
  local key="$1" value="$2" source="$3"
  allowed_key "$key" || die "unsupported configuration key: $key"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* && "$value" != *$'\t'* ]] ||
    die "configuration value for $key contains a prohibited control character"
  values["$key"]="$value"
  sources["$key"]="$source"
}

load_yaml_lines() {
  local path="$1"
  [[ -r "$path" ]] || die "configuration file is not readable: $path"
  if command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' >/dev/null 2>&1; then
    python3 - "$path" <<'PY'
import sys
import yaml

allowed = {
    "version", "application_name", "deployment_shape", "infrastructure_repository",
    "infrastructure_ref", "aws.region", "aws.state_bucket",
    "aws.availability_zone", "aws.route53_zone_name", "aws.route53_zone_id",
    "ami.subnet_id", "ami.ssh_cidr", "ami.name_prefix",
    "backend.ssm_parameters_path", "backend.parameter_path", "backend.compose_file", "backend.caddy_file",
    "backend.build_context", "backend.dockerfile", "backend.supplemental_files",
    "defaults.target_environment", "defaults.instance_type", "defaults.root_volume_size_gib",
    "defaults.data_volume_size_gib", "defaults.release_retention_days",
    "defaults.enable_data_volume_backups", "defaults.backup_kms_key_arn",
    "defaults.retain_data_volume", "defaults.retain_eip",
    "frontend.directory", "frontend.build_command", "frontend.deploy_command",
    "frontend.remove_command", "frontend.output_entrypoint", "frontend.frontend_url",
    "frontend.api_url", "frontend.frontend_origin", "frontend.api_base_url",
    "frontend.frontend_hostname", "frontend.frontend_certificate_arn",
    "frontend.aws_role_secret",
}

with open(sys.argv[1], encoding="utf-8") as stream:
    document = yaml.safe_load(stream) or {}
if not isinstance(document, dict):
    raise SystemExit("configuration root must be a YAML mapping")

def flatten(value, prefix=""):
    if isinstance(value, dict):
        for key, child in value.items():
            if not isinstance(key, str):
                raise SystemExit("configuration keys must be strings")
            child_key = f"{prefix}.{key}" if prefix else key
            yield from flatten(child, child_key)
    elif isinstance(value, (str, int, float, bool)) or value is None:
        rendered = "" if value is None else str(value).lower() if isinstance(value, bool) else str(value)
        yield prefix, rendered
    else:
        raise SystemExit(f"configuration value for {prefix} must be scalar")

for key, value in flatten(document):
    if key not in allowed:
        raise SystemExit(f"unsupported configuration key: {key}")
    if key == "backend.parameter_path":
        key = "backend.ssm_parameters_path"
    print(f"{key}\t{value}")
PY
    return
  fi

  if command -v ruby >/dev/null 2>&1 && ruby -e 'require "yaml"' >/dev/null 2>&1; then
    ruby -ryaml - "$path" <<'RUBY'
allowed = %w[
  version application_name deployment_shape infrastructure_repository infrastructure_ref
  aws.region aws.state_bucket aws.availability_zone aws.route53_zone_name
  aws.route53_zone_id ami.subnet_id ami.ssh_cidr ami.name_prefix
  backend.ssm_parameters_path backend.compose_file
  backend.caddy_file backend.build_context backend.dockerfile backend.supplemental_files
  backend.parameter_path
  defaults.target_environment defaults.instance_type defaults.root_volume_size_gib defaults.data_volume_size_gib
  defaults.release_retention_days defaults.enable_data_volume_backups
  defaults.backup_kms_key_arn defaults.retain_data_volume defaults.retain_eip
  frontend.directory frontend.build_command frontend.deploy_command
  frontend.remove_command frontend.output_entrypoint frontend.frontend_url
  frontend.api_url frontend.frontend_origin frontend.api_base_url
  frontend.frontend_hostname frontend.frontend_certificate_arn frontend.aws_role_secret
]
document = YAML.safe_load(File.read(ARGV.fetch(0)), permitted_classes: [], aliases: false) || {}
abort 'configuration root must be a YAML mapping' unless document.is_a?(Hash)
flatten = lambda do |value, prefix = '', &block|
  if value.is_a?(Hash)
    value.each do |key, child|
      abort 'configuration keys must be strings' unless key.is_a?(String)
      flatten.call(child, prefix.empty? ? key : "#{prefix}.#{key}", &block)
    end
  elsif value.is_a?(String) || value.is_a?(Numeric) || value == true || value == false || value.nil?
    block.call(prefix, value.nil? ? '' : value.to_s)
  else
    abort "configuration value for #{prefix} must be scalar"
  end
end
flatten.call(document) do |key, value|
  abort "unsupported configuration key: #{key}" unless allowed.include?(key)
  key = 'backend.ssm_parameters_path' if key == 'backend.parameter_path'
  puts "#{key}\t#{value}"
end
RUBY
    return
  fi

  die "YAML configuration requires Python 3 with PyYAML or Ruby with Psych"
}

load_defaults() {
  set_value version 1 default
  set_value application_name application default
  set_value deployment_shape backend-and-frontend default
  set_value infrastructure_repository kanutocd/poorman-aws default
  set_value infrastructure_ref "$wrapper_release_ref" default
  set_value aws.region ap-southeast-1 default
  set_value aws.availability_zone '' default
  set_value aws.route53_zone_name '' default
  set_value aws.route53_zone_id '' default
  set_value ami.subnet_id '' default
  set_value ami.ssh_cidr '' default
  set_value ami.name_prefix '' default
  set_value backend.ssm_parameters_path /application/staging default
  set_value backend.compose_file backend/compose.production.yaml default
  set_value backend.caddy_file backend/Caddyfile default
  set_value backend.build_context backend default
  set_value backend.dockerfile backend/Dockerfile default
  set_value backend.supplemental_files '' default
  set_value defaults.target_environment staging default
  set_value defaults.instance_type t4g.micro default
  set_value defaults.root_volume_size_gib 10 default
  set_value defaults.data_volume_size_gib 20 default
  set_value defaults.release_retention_days 30 default
  set_value defaults.enable_data_volume_backups true default
  set_value defaults.backup_kms_key_arn '' default
  set_value defaults.retain_data_volume true default
  set_value defaults.retain_eip true default
  set_value frontend.directory frontend default
  set_value frontend.build_command 'pnpm build' default
  set_value frontend.deploy_command 'bash poorman-aws/bin/frontend-adapter deploy' default
  set_value frontend.remove_command 'bash poorman-aws/bin/frontend-adapter remove' default
  set_value frontend.output_entrypoint dist/index.html default
  set_value frontend.frontend_url '' default
  set_value frontend.api_url '' default
  set_value frontend.frontend_origin '' default
  set_value frontend.api_base_url '' default
  set_value frontend.frontend_hostname '' default
  set_value frontend.frontend_certificate_arn '' default
  set_value frontend.aws_role_secret AWS_FRONTEND_ROLE_ARN default
}

load_config() {
  local path='' parsed=''
  if [[ "$config_explicit" == true ]]; then
    path="$config_path"
  elif [[ -f .poorman-aws.yml && -f .poorman-aws.yaml ]]; then
    die 'both .poorman-aws.yml and .poorman-aws.yaml exist; use --config'
  elif [[ -f .poorman-aws.yml ]]; then
    path=.poorman-aws.yml
  elif [[ -f .poorman-aws.yaml ]]; then
    path=.poorman-aws.yaml
  elif [[ -f "$(consumer_config_state_file)" ]]; then
    path="$(consumer_config_state_file)"
  fi
  [[ -z "$path" ]] && return
  parsed="$(load_yaml_lines "$path")" || die "could not load configuration: $path"
  while IFS=$'\t' read -r key value; do
    [[ -n "$key" ]] && set_value "$key" "$value" "config:$path"
  done <<< "$parsed"
}

parse_args() {
  local key value arg
  (($# > 0)) || { usage; exit 0; }
  while (($# > 0)); do
    arg="$1"
    case "$arg" in
      --help|-h) usage; exit 0 ;;
      --version) printf '%s\n' 'poorman-aws wrapper contract 0.1.0'; exit 0 ;;
      --config) (($# >= 2)) || die '--config requires a path'; config_path="$2"; config_explicit=true; shift 2; continue ;;
      --consumer-path) (($# >= 2)) || die '--consumer-path requires a path'; consumer_path_option="$2"; shift 2; continue ;;
      --non-interactive) non_interactive=true; shift; continue ;;
      --json) json_output=true; shift; continue ;;
      --dry-run) dry_run=true; shift; continue ;;
      --overwrite) overwrite=true; shift; continue ;;
      --offline) offline=true; shift; continue ;;
      --aws) check_aws=true; shift; continue ;;
      --docker) check_docker=true; shift; continue ;;
      --infra) check_infra=true; shift; continue ;;
      --ami) check_ami=true; shift; continue ;;
      --github) check_github=true; shift; continue ;;
      --setup-auth) setup_auth=true; shift; continue ;;
      --update) update_install=true; shift; continue ;;
      --environment) (($# >= 2)) || die '--environment requires a value'; command_environment="$2"; shift 2; continue ;;
      --apply) command_apply=true; shift; continue ;;
      --confirm) (($# >= 2)) || die '--confirm requires a value'; command_confirm="$2"; shift 2; continue ;;
      --repo) (($# >= 2)) || die '--repo requires a value'; command_repo="$2"; shift 2; continue ;;
      --release-id) (($# >= 2)) || die '--release-id requires a value'; command_release_id="$2"; shift 2; continue ;;
      --action) (($# >= 2)) || die '--action requires a value'; command_action="$2"; shift 2; continue ;;
      --subnet-id) (($# >= 2)) || die '--subnet-id requires a value'; command_subnet_id="$2"; shift 2; continue ;;
      --ami-name-prefix) (($# >= 2)) || die '--ami-name-prefix requires a value'; command_ami_name_prefix="$2"; shift 2; continue ;;
      --from-env-file) (($# >= 2)) || die '--from-env-file requires a path'; command_env_file="$2"; shift 2; continue ;;
      --clear-parameter) (($# >= 2)) || die '--clear-parameter requires a name'; command_clear_parameter="$2"; shift 2; continue ;;
      --non-secret) (($# >= 2)) || die '--non-secret requires a name'; command_non_secret_parameters+=("$2"); shift 2; continue ;;
      --allow-type-change) command_allow_type_change=true; shift; continue ;;
      --release-file) (($# >= 2)) || die '--release-file requires DEST=PATH'; command_supplemental_files+=("$2"); shift 2; continue ;;
      --consumer-ref) (($# >= 2)) || die '--consumer-ref requires a value'; command_consumer_ref="$2"; shift 2; continue ;;
      --deployment-shape) key=deployment_shape ;;
      --frontend-directory) key=frontend.directory ;;
      --build-command) key=frontend.build_command ;;
      --deploy-command) key=frontend.deploy_command ;;
      --remove-command) key=frontend.remove_command ;;
      --output-entrypoint) key=frontend.output_entrypoint ;;
      --frontend-url) key=frontend.frontend_url ;;
      --api-url) key=frontend.api_url ;;
      --frontend-origin) key=frontend.frontend_origin ;;
      --api-base-url) key=frontend.api_base_url ;;
      --frontend-hostname) key=frontend.frontend_hostname ;;
      --frontend-certificate-arn) key=frontend.frontend_certificate_arn ;;
      --aws-role-secret) key=frontend.aws_role_secret ;;
      --cors-path) (($# >= 2)) || die '--cors-path requires a value'; command_cors_path="$2"; shift 2; continue ;;
      --websocket-path) (($# >= 2)) || die '--websocket-path requires a value'; command_websocket_path="$2"; shift 2; continue ;;
      --wait) command_wait=true; shift; continue ;;
      --availability-zone) key=aws.availability_zone ;;
      --ami-subnet-id) key=ami.subnet_id ;;
      --route53-zone-name) key=aws.route53_zone_name ;;
      --route53-zone-id) key=aws.route53_zone_id ;;
      --release-retention-days) key=defaults.release_retention_days ;;
      --target-environment) key=defaults.target_environment ;;
      --backup-kms-key-arn) key=defaults.backup_kms_key_arn ;;
      --retain-data-volume) cli_values[defaults.retain_data_volume]=true; shift; continue ;;
      --retain-eip) cli_values[defaults.retain_eip]=true; shift; continue ;;
      --application-name) key=application_name ;;
      --infrastructure-repository) key=infrastructure_repository ;;
      --infrastructure-ref) key=infrastructure_ref ;;
      --aws-region) key=aws.region ;;
      --state-bucket) key=aws.state_bucket ;;
      --parameter-path|--ssm-parameters-path) key=backend.ssm_parameters_path ;;
      --compose-file) key=backend.compose_file ;;
      --caddy-file) key=backend.caddy_file ;;
      --build-context) key=backend.build_context ;;
      --dockerfile) key=backend.dockerfile ;;
      --instance-type) key=defaults.instance_type ;;
      --root-volume-size-gib) key=defaults.root_volume_size_gib ;;
      --data-volume-size-gib) key=defaults.data_volume_size_gib ;;
      --*) die "unknown option: $arg" ;;
      *)
        if [[ -z "$command_name" ]]; then command_name="$arg"; else command_args+=("$arg"); fi
        shift
        continue ;;
    esac
    (($# >= 2)) || die "$arg requires a value"
    cli_values["$key"]="$2"
    shift 2
  done
  [[ -n "$command_name" ]] || die 'a command is required'
}

apply_cli_values() {
  local key
  for key in "${!cli_values[@]}"; do set_value "$key" "${cli_values[$key]}" cli; done
}

validate_values() {
  [[ "${values[version]}" == 1 ]] || die 'configuration version must be 1'
  [[ "${values[application_name]}" =~ ^[a-z][a-z0-9-]{1,32}$ ]] ||
    die 'application_name must be 2-33 lowercase letters, numbers, or hyphens'
  [[ "${values[deployment_shape]}" =~ ^(backend-and-frontend|backend-only|frontend-only)$ ]] ||
    die 'deployment_shape must be backend-and-frontend, backend-only, or frontend-only'
  [[ "${values[infrastructure_repository]}" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] ||
    die 'infrastructure_repository must be OWNER/REPOSITORY'
  [[ -n "${values[infrastructure_ref]}" && "${values[infrastructure_ref]}" != *' '* ]] ||
    die 'infrastructure_ref must be a non-empty ref'
  [[ "${values[aws.region]}" =~ ^[a-z0-9-]+$ ]] || die 'aws.region is invalid'
  [[ "${values[defaults.target_environment]}" =~ ^(staging|production)$ ]] ||
    die 'target_environment must be staging or production'
  if [[ -n "${values[aws.availability_zone]}" ]]; then
    [[ "${values[aws.availability_zone]}" =~ ^[a-z0-9-]+$ ]] || die 'aws.availability_zone is invalid'
  fi
  [[ -z "${values[aws.route53_zone_name]}" || "${values[aws.route53_zone_name]}" =~ ^[A-Za-z0-9.-]+$ ]] ||
    die 'aws.route53_zone_name is invalid'
  [[ "${values[backend.ssm_parameters_path]}" =~ ^/[^/].*[^/]$ ]] ||
    die 'backend.ssm_parameters_path must be an absolute SSM path'
  [[ "${values[defaults.instance_type]}" =~ ^[a-z0-9.-]+$ ]] || die 'instance_type is invalid'
  [[ "${values[defaults.root_volume_size_gib]}" =~ ^[0-9]+$ && "${values[defaults.root_volume_size_gib]}" -ge 8 ]] ||
    die 'root_volume_size_gib must be an integer of at least 8'
  [[ "${values[defaults.data_volume_size_gib]}" =~ ^[0-9]+$ && "${values[defaults.data_volume_size_gib]}" -ge 8 ]] ||
    die 'data_volume_size_gib must be an integer of at least 8'
  [[ "${values[defaults.release_retention_days]}" =~ ^[0-9]+$ && "${values[defaults.release_retention_days]}" -ge 1 ]] ||
    die 'release_retention_days must be an integer of at least 1'
  [[ "${values[defaults.enable_data_volume_backups]}" =~ ^(true|false)$ ]] ||
    die 'enable_data_volume_backups must be true or false'
  [[ "${values[defaults.retain_data_volume]}" =~ ^(true|false)$ ]] ||
    die 'retain_data_volume must be true or false'
  [[ "${values[defaults.retain_eip]}" =~ ^(true|false)$ ]] ||
    die 'retain_eip must be true or false'
  [[ "${values[frontend.directory]}" != /* && "${values[frontend.directory]}" != *'..'* ]] ||
    die 'frontend.directory must be a relative path without ..'
  [[ -n "${values[frontend.build_command]}" && -n "${values[frontend.deploy_command]}" ]] ||
    die 'frontend build_command and deploy_command are required'
  [[ -n "${values[frontend.remove_command]}" ]] || die 'frontend remove_command is required'
  [[ -z "${values[frontend.output_entrypoint]}" || "${values[frontend.output_entrypoint]}" != /* ]] ||
    die 'frontend.output_entrypoint must be relative'
  for key in frontend.frontend_url frontend.api_url frontend.frontend_origin frontend.api_base_url; do
    [[ -z "${values[$key]}" || "${values[$key]}" =~ ^https?://[^[:space:]]+$ ]] || die "$key must be an http(s) URL"
  done
  [[ -z "${values[frontend.frontend_hostname]}" || "${values[frontend.frontend_hostname]}" =~ ^[A-Za-z0-9.-]+$ ]] ||
    die 'frontend.frontend_hostname is invalid'
  [[ "${values[frontend.aws_role_secret]}" =~ ^[A-Z][A-Z0-9_]*$ ]] || die 'frontend.aws_role_secret must be an environment secret name'
}

show_config() {
  local key
  if [[ "$json_output" == true ]]; then
    command -v jq >/dev/null 2>&1 || die '--json requires jq'
    for key in "${!values[@]}"; do printf '%s\t%s\t%s\n' "$key" "${values[$key]}" "${sources[$key]}"; done |
      sort | jq -Rn '[inputs | split("\t") | {key: .[0], value: .[1], source: .[2]}]'
  else
    while IFS= read -r key; do
      printf '%-36s %s (source: %s)\n' "$key" "${values[$key]}" "${sources[$key]}"
    done < <(printf '%s\n' "${!values[@]}" | sort)
  fi
}

prompt_value() {
  local key="$1" label="$2" required="${3:-false}" example="${4:-}" current="${values[$1]-}" answer
  if [[ -n "$current" && "${sources[$key]-}" != inferred && ( "${sources[$key]-}" != default || "$required" != true ) ]]; then
    return
  fi
  if [[ "$non_interactive" == true ]]; then
    die "$key is required in --non-interactive mode; set it in --config or on the command line"
  fi
  while true; do
    if [[ -n "$current" ]]; then
      printf '%s [%s]: ' "$label" "$current" >&2
    elif [[ -n "$example" ]]; then
      printf '%s (example: %s): ' "$label" "$example" >&2
    else
      printf '%s: ' "$label" >&2
    fi
    IFS= read -r answer || die "unable to read a value for $key"
    if [[ -n "$answer" ]]; then
      set_value "$key" "$answer" prompt
      return 0
    fi
    if [[ "$required" != true || -n "$current" ]]; then
      return 0
    fi
    echo "$label is required; enter a value to continue" >&2
  done
}

detect_onboarding_paths() {
  local candidate
  if [[ "${sources[backend.compose_file]-}" == default ]]; then
    for candidate in deployment/backend/compose.production.yaml backend/compose.production.yaml compose.yaml; do
      if [[ -f "$PWD/$candidate" ]]; then set_value backend.compose_file "$candidate" detected; break; fi
    done
  fi
  if [[ "${sources[backend.caddy_file]-}" == default ]]; then
    for candidate in deployment/backend/Caddyfile backend/Caddyfile Caddyfile; do
      if [[ -f "$PWD/$candidate" ]]; then set_value backend.caddy_file "$candidate" detected; break; fi
    done
  fi
  if [[ "${sources[backend.dockerfile]-}" == default ]]; then
    for candidate in backend/Dockerfile Dockerfile; do
      if [[ -f "$PWD/$candidate" ]]; then set_value backend.dockerfile "$candidate" detected; break; fi
    done
  fi
}

infer_aws_availability_zone() {
  local availability_zone
  [[ "$offline" != true ]] || return 0
  [[ -z "${values[aws.availability_zone]}" ]] || return 0
  command -v aws >/dev/null 2>&1 || return 0
  [[ -n "${values[aws.region]}" ]] || return 0
  availability_zone="$(aws ec2 describe-availability-zones \
    --region "${values[aws.region]}" \
    --filters Name=state,Values=available Name=zone-type,Values=availability-zone \
    --query 'AvailabilityZones[0].ZoneName' \
    --output text 2>/dev/null || true)"
  if [[ "$availability_zone" =~ ^[a-z0-9-]+[a-z]$ ]]; then
    set_value aws.availability_zone "$availability_zone" inferred
  fi
}

infer_route53_zone_name() {
  local zone hosted_zones
  local -a public_zones=()
  [[ "$offline" != true ]] || return 0
  [[ -z "${values[aws.route53_zone_name]}" ]] || return 0
  command -v aws >/dev/null 2>&1 || return 0
  command -v jq >/dev/null 2>&1 || return 0
  hosted_zones="$(aws route53 list-hosted-zones --output json 2>/dev/null || true)"
  [[ -n "$hosted_zones" ]] || return 0
  mapfile -t public_zones < <(jq -r '.HostedZones[] | select(.Config.PrivateZone == false) | .Name | rtrimstr(".")' <<<"$hosted_zones")
  if (( ${#public_zones[@]} == 1 )); then
    zone="${public_zones[0]}"
    set_value aws.route53_zone_name "$zone" inferred
  elif (( ${#public_zones[@]} == 0 )); then
    echo 'hint: no public Route 53 hosted zone found; enter the DNS zone name explicitly or create a public hosted zone first' >&2
  fi
}

infer_ami_subnet_id() {
  local subnet_id
  [[ "$offline" != true ]] || return 0
  [[ -z "${values[ami.subnet_id]}" ]] || return 0
  command -v aws >/dev/null 2>&1 || return 0
  [[ -n "${values[aws.region]}" && -n "${values[aws.availability_zone]}" ]] || return 0
  subnet_id="$(aws ec2 describe-subnets \
    --region "${values[aws.region]}" \
    --filters \
      "Name=availability-zone,Values=${values[aws.availability_zone]}" \
      Name=state,Values=available \
      Name=map-public-ip-on-launch,Values=true \
    --query 'Subnets[0].SubnetId' --output text 2>/dev/null || true)"
  if [[ "$subnet_id" =~ ^subnet-[0-9a-f]+$ ]]; then
    set_value ami.subnet_id "$subnet_id" inferred
  else
    echo 'hint: no public subnet was inferred for the selected Availability Zone; enter an AMI build subnet explicitly' >&2
  fi
}

require_onboarding_values() {
  local route53_example application_slug
  detect_onboarding_paths
  infer_aws_availability_zone
  infer_route53_zone_name
  infer_ami_subnet_id
  prompt_value application_name 'Application name' true
  prompt_value deployment_shape 'Deployment shape (backend-and-frontend, backend-only, or frontend-only)' true
  if [[ -n "$command_ami_name_prefix" ]]; then
    set_value ami.name_prefix "$command_ami_name_prefix" cli
  fi
  if [[ -z "${values[ami.name_prefix]}" ]]; then
    set_value ami.name_prefix "${values[application_name]}-backend" inferred
  fi
  prompt_value infrastructure_repository 'Infrastructure repository'
  if [[ "${values[infrastructure_ref]}" != "$wrapper_release_ref" ]]; then
    echo "info: generated workflows are pinned to the wrapper release $wrapper_release_ref" >&2
  fi
  values[infrastructure_ref]="$wrapper_release_ref"
  sources[infrastructure_ref]='wrapper release'
  prompt_value aws.region 'AWS region'
  prompt_value aws.availability_zone 'AWS availability zone' true
  if [[ "${values[deployment_shape]}" != frontend-only ]]; then
    prompt_value ami.subnet_id 'AMI public subnet ID' true
  fi
  application_slug="${values[application_name]%-app}"
  route53_example="${application_slug}.com"
  prompt_value aws.route53_zone_name 'Route 53 zone name' true "$route53_example"
  prompt_value aws.state_bucket 'Encrypted remote state bucket' true
  prompt_value backend.ssm_parameters_path 'SSM parameters path'
  prompt_value backend.compose_file 'Consumer Compose file'
  prompt_value backend.caddy_file 'Consumer Caddyfile'
  prompt_value backend.build_context 'Docker build context'
  prompt_value backend.dockerfile 'Application Dockerfile'
  validate_values
  local key
  for key in application_name infrastructure_repository infrastructure_ref aws.region aws.availability_zone \
    aws.route53_zone_name aws.state_bucket \
    ami.subnet_id ami.name_prefix \
    backend.ssm_parameters_path backend.compose_file backend.caddy_file backend.build_context backend.dockerfile; do
    [[ "${values[$key]}" != *'|'* ]] || die "$key cannot contain the template delimiter |"
  done
  for key in frontend.directory frontend.build_command frontend.deploy_command frontend.remove_command \
    frontend.output_entrypoint frontend.frontend_url frontend.api_url frontend.frontend_origin \
    frontend.api_base_url frontend.frontend_hostname frontend.frontend_certificate_arn frontend.aws_role_secret; do
    [[ "${values[$key]}" != *'|'* ]] || die "$key cannot contain the template delimiter |"
  done
}

onboarding_tmp=''
onboard_cleanup() {
  [[ -z "$onboarding_tmp" ]] || rm -rf "$onboarding_tmp"
}

stage_onboarding_file() {
  local target="$1" content="$2" staged
  staged="$onboarding_tmp/$(printf '%s' "$target" | tr '/' '_')"
  mkdir -p "$(dirname "$staged")"
  printf '%s\n' "$content" >"$staged"
  generated_targets+=("$target")
  generated_sources+=("$staged")
}

render_workflow() {
  local template="$1"
  template="${template//__REPOSITORY__/${values[infrastructure_repository]}}"
  template="${template//__REF__/${wrapper_release_ref}}"
  template="${template//__APP__/${values[application_name]}}"
  template="${template//__REGION__/${values[aws.region]}}"
  template="${template//__TARGET_ENVIRONMENT__/${values[defaults.target_environment]}}"
  template="${template//__AZ__/${values[aws.availability_zone]}}"
  template="${template//__ZONE__/${values[aws.route53_zone_name]}}"
  template="${template//__ZONE_ID__/${values[aws.route53_zone_id]}}"
  template="${template//__AMI_SUBNET_ID__/${values[ami.subnet_id]}}"
  template="${template//__AMI_NAME_PREFIX__/${values[ami.name_prefix]}}"
  template="${template//__STATE_BUCKET__/${values[aws.state_bucket]}}"
  template="${template//__PARAMETER_PATH__/${values[backend.ssm_parameters_path]}}"
  template="${template//__COMPOSE__/${values[backend.compose_file]}}"
  template="${template//__CADDY__/${values[backend.caddy_file]}}"
  template="${template//__CONTEXT__/${values[backend.build_context]}}"
  template="${template//__DOCKERFILE__/${values[backend.dockerfile]}}"
  template="${template//__SUPPLEMENTAL_FILES__/${values[backend.supplemental_files]}}"
  template="${template//__INSTANCE_TYPE__/${values[defaults.instance_type]}}"
  template="${template//__ROOT_VOLUME_SIZE__/${values[defaults.root_volume_size_gib]}}"
  template="${template//__DATA_VOLUME_SIZE__/${values[defaults.data_volume_size_gib]}}"
  template="${template//__RETAIN_EIP__/${values[defaults.retain_eip]}}"
  template="${template//__RETAIN_DATA_VOLUME__/${values[defaults.retain_data_volume]}}"
  template="${template//__RELEASE_RETENTION_DAYS__/${values[defaults.release_retention_days]}}"
  template="${template//__ENABLE_BACKUPS__/${values[defaults.enable_data_volume_backups]}}"
  template="${template//__BACKUP_KMS_KEY_ARN__/${values[defaults.backup_kms_key_arn]}}"
  template="${template//__FRONTEND_DIRECTORY__/${values[frontend.directory]}}"
  template="${template//__FRONTEND_BUILD_COMMAND__/${values[frontend.build_command]}}"
  template="${template//__FRONTEND_DEPLOY_COMMAND__/${values[frontend.deploy_command]}}"
  template="${template//__FRONTEND_REMOVE_COMMAND__/${values[frontend.remove_command]}}"
  template="${template//__FRONTEND_OUTPUT_ENTRYPOINT__/${values[frontend.output_entrypoint]}}"
  template="${template//__FRONTEND_URL__/${values[frontend.frontend_url]}}"
  template="${template//__API_URL__/${values[frontend.api_url]}}"
  template="${template//__FRONTEND_ORIGIN__/${values[frontend.frontend_origin]}}"
  template="${template//__API_BASE_URL__/${values[frontend.api_base_url]}}"
  template="${template//__FRONTEND_HOSTNAME__/${values[frontend.frontend_hostname]}}"
  template="${template//__FRONTEND_CERTIFICATE_ARN__/${values[frontend.frontend_certificate_arn]}}"
  template="${template//__FRONTEND_ROLE_SECRET__/${values[frontend.aws_role_secret]}}"
  printf '%s' "$template"
}

prepare_onboarding_files() {
  local config_content infra deploy rollback ami lifecycle parameters frontend_deploy frontend_rollback frontend_lifecycle
  onboarding_tmp="$(mktemp -d "${TMPDIR:-/tmp}/poorman-aws-onboard.XXXXXX")"
  generated_targets=()
  generated_sources=()
  config_content="$(cat <<EOF
version: 1
application_name: ${values[application_name]}
deployment_shape: ${values[deployment_shape]}
infrastructure_repository: ${values[infrastructure_repository]}
infrastructure_ref: ${wrapper_release_ref}
aws:
  region: ${values[aws.region]}
  availability_zone: ${values[aws.availability_zone]}
  route53_zone_name: ${values[aws.route53_zone_name]}
  route53_zone_id: ${values[aws.route53_zone_id]}
  state_bucket: ${values[aws.state_bucket]}
ami:
  subnet_id: ${values[ami.subnet_id]}
  name_prefix: ${values[ami.name_prefix]}
backend:
  ssm_parameters_path: ${values[backend.ssm_parameters_path]}
  compose_file: ${values[backend.compose_file]}
  caddy_file: ${values[backend.caddy_file]}
  build_context: ${values[backend.build_context]}
  dockerfile: ${values[backend.dockerfile]}
  supplemental_files: ${values[backend.supplemental_files]}
defaults:
  target_environment: ${values[defaults.target_environment]}
  instance_type: ${values[defaults.instance_type]}
  root_volume_size_gib: ${values[defaults.root_volume_size_gib]}
  data_volume_size_gib: ${values[defaults.data_volume_size_gib]}
  release_retention_days: ${values[defaults.release_retention_days]}
  enable_data_volume_backups: ${values[defaults.enable_data_volume_backups]}
  backup_kms_key_arn: ${values[defaults.backup_kms_key_arn]}
  retain_data_volume: ${values[defaults.retain_data_volume]}
  retain_eip: ${values[defaults.retain_eip]}
frontend:
  directory: ${values[frontend.directory]}
  build_command: ${values[frontend.build_command]}
  deploy_command: ${values[frontend.deploy_command]}
  remove_command: ${values[frontend.remove_command]}
  output_entrypoint: ${values[frontend.output_entrypoint]}
  frontend_url: ${values[frontend.frontend_url]}
  api_url: ${values[frontend.api_url]}
  frontend_origin: ${values[frontend.frontend_origin]}
  api_base_url: ${values[frontend.api_base_url]}
  frontend_hostname: ${values[frontend.frontend_hostname]}
  frontend_certificate_arn: ${values[frontend.frontend_certificate_arn]}
  aws_role_secret: ${values[frontend.aws_role_secret]}
EOF
)"
  if [[ "$config_explicit" == false ]]; then stage_onboarding_file .poorman-aws.yml "$config_content"; fi

  infra="$(cat <<'EOF'
name: Build `poorman-aws` backend infrastructure
on:
  # Future automation examples (disabled by default). Enable only after
  # reviewing apply permissions and environment protections:
  # push:
  #   branches: [main]
  # pull_request:
  #   branches: [main]
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
  # schedule:
  #   - cron: "17 3 * * 1"
  workflow_dispatch:
    inputs:
      environment:
        description: Target environment
        required: true
        default: __TARGET_ENVIRONMENT__
        type: choice
        options: [staging, production]
      apply:
        description: Apply infrastructure changes
        required: true
        default: false
        type: boolean
permissions:
  contents: read
  actions: write
  id-token: write
jobs:
  infrastructure:
    uses: __REPOSITORY__/.github/workflows/deploy-backend-infra.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      environment: ${{ github.event_name == 'workflow_dispatch' && inputs.environment || '__TARGET_ENVIRONMENT__' }}
      apply: ${{ github.event_name == 'workflow_dispatch' && inputs.apply || false }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      availability_zone: ${{ vars.AVAILABILITY_ZONE || '__AZ__' }}
      instance_type: ${{ vars.INSTANCE_TYPE || '__INSTANCE_TYPE__' }}
      root_volume_size_gib: ${{ vars.ROOT_VOLUME_SIZE_GIB || __ROOT_VOLUME_SIZE__ }}
      data_volume_size_gib: ${{ vars.DATA_VOLUME_SIZE_GIB || __DATA_VOLUME_SIZE__ }}
      retain_eip: ${{ vars.RETAIN_EIP || __RETAIN_EIP__ }}
      retain_data_volume: ${{ vars.RETAIN_DATA_VOLUME || __RETAIN_DATA_VOLUME__ }}
      release_retention_days: ${{ vars.RELEASE_RETENTION_DAYS || __RELEASE_RETENTION_DAYS__ }}
      enable_data_volume_backups: ${{ vars.ENABLE_DATA_VOLUME_BACKUPS || __ENABLE_BACKUPS__ }}
      backup_kms_key_arn: ${{ vars.BACKUP_KMS_KEY_ARN || '__BACKUP_KMS_KEY_ARN__' }}
      ami_subnet_id: __AMI_SUBNET_ID__
      ami_name_prefix: __AMI_NAME_PREFIX__
      ssm_parameter_path: __PARAMETER_PATH__
      ssm_session_kms_key_arn: ${{ vars.SSM_SESSION_KMS_KEY_ARN }}
      route53_zone_name: ${{ vars.ROUTE53_ZONE_NAME || '__ZONE__' }}
      route53_zone_id: ${{ vars.ROUTE53_ZONE_ID || '__ZONE_ID__' }}
      tags_json: '{}'
    secrets: inherit
EOF
)"
  deploy="$(cat <<'EOF'
name: Deploy `poorman-aws` backend release
on:
  # Future automation examples (disabled by default). Enable only after
  # reviewing deployment permissions and the generated literal fallbacks:
  # push:
  #   branches: [main]
  # pull_request:
  #   branches: [main]
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
  workflow_dispatch:
    inputs:
      environment:
        required: true
        default: __TARGET_ENVIRONMENT__
        type: choice
        options: [staging, production]
      supplemental_files:
        description: Optional comma-separated DEST=PATH release files
        required: false
        default: ''
        type: string
permissions:
  contents: read
  actions: read
jobs:
  deploy:
    uses: __REPOSITORY__/.github/workflows/deploy-backend.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      environment: ${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      api_url: ${{ vars.API_URL }}
      compose_file: __COMPOSE__
      caddy_file: __CADDY__
      build_context: __CONTEXT__
      dockerfile: __DOCKERFILE__
      supplemental_files: ${{ inputs.supplemental_files || '__SUPPLEMENTAL_FILES__' }}
      frontend_url: ${{ vars.FRONTEND_URL }}
      frontend_origin: ${{ vars.FRONTEND_ORIGIN }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      application_api_token: ${{ secrets.APPLICATION_API_TOKEN }}
EOF
)"
  rollback="$(cat <<'EOF'
name: Roll back `poorman-aws` backend release
on:
  # Keep rollback manual by default. A future workflow_run trigger must
  # supply a reviewed consumer_ref and explicit rollback confirmation:
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
  workflow_dispatch:
    inputs:
      environment:
        required: true
        default: __TARGET_ENVIRONMENT__
        type: choice
        options: [staging, production]
      release_id:
        required: true
        type: string
permissions:
  contents: read
jobs:
  rollback:
    uses: __REPOSITORY__/.github/workflows/rollback-backend.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      consumer_ref: ${{ github.sha }}
      application_name: __APP__
      environment: ${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}
      aws_region: __REGION__
      state_bucket: __STATE_BUCKET__
      release_id: ${{ inputs.release_id }}
      api_url: ${{ vars.API_URL }}
      compose_file: __COMPOSE__
      caddy_file: __CADDY__
      frontend_url: ${{ vars.FRONTEND_URL }}
      frontend_origin: ${{ vars.FRONTEND_ORIGIN }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
      application_api_token: ${{ secrets.APPLICATION_API_TOKEN }}
EOF
)"
  ami="$(cat <<'EOF'
name: Build `poorman-aws` backend AMI
on:
  # Keep AMI builds manual by default because they create AWS resources and
  # incur cost. A future schedule or workflow_run trigger must be reviewed:
  # schedule:
  #   - cron: "17 3 * * 1"
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
  workflow_dispatch:
    inputs:
      subnet_id:
        required: true
        default: __AMI_SUBNET_ID__
        type: string
      ami_name_prefix:
        required: true
        default: __AMI_NAME_PREFIX__
        type: string
      environment:
        description: Environment that receives AMI_ID
        required: true
        default: __TARGET_ENVIRONMENT__
        type: choice
        options: [staging, production]
permissions:
  contents: read
  actions: write
  id-token: write
jobs:
  ami:
    uses: __REPOSITORY__/.github/workflows/build-backend-ami.yml@__REF__
    with:
      infrastructure_repository: __REPOSITORY__
      infrastructure_ref: __REF__
      application_name: __APP__
      aws_region: __REGION__
      subnet_id: ${{ inputs.subnet_id || '__AMI_SUBNET_ID__' }}
      ami_name_prefix: ${{ inputs.ami_name_prefix || '__AMI_NAME_PREFIX__' }}
      target_environment: ${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}
    secrets:
      aws_role_arn: ${{ secrets.AWS_ROLE_ARN }}
  persist_environment_backup:
    name: Mirror AMI metadata to the consumer environment
    needs: ami
    if: needs.ami.result == 'success'
    runs-on: ubuntu-latest
    environment: ${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}
    permissions:
      actions: write
    env:
      GH_TOKEN: ${{ secrets.POORMAN_ENVIRONMENT_ADMIN_TOKEN }}
      AMI_ID: ${{ needs.ami.outputs.ami_id }}
      AMI_BUILD_FINGERPRINT: ${{ needs.ami.outputs.build_fingerprint }}
    steps:
      - name: Mirror AMI metadata when an admin token is configured
        if: env.GH_TOKEN != ''
        run: |
          set -euo pipefail
          printf '%s' "$AMI_ID" |
            gh variable set AMI_ID --env "${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}" --repo "${GITHUB_REPOSITORY}"
          printf '%s' "$AMI_BUILD_FINGERPRINT" |
            gh variable set AMI_BUILD_FINGERPRINT --env "${{ inputs.environment || '__TARGET_ENVIRONMENT__' }}" --repo "${GITHUB_REPOSITORY}"

      - name: Explain skipped environment backup
        if: env.GH_TOKEN == ''
        run: echo 'POORMAN_ENVIRONMENT_ADMIN_TOKEN is not configured; SSM and artifact persistence remain authoritative.'
EOF
)"
  lifecycle="$(cat <<'EOF'
name: Manage `poorman-aws` non-production lifecycle
on:
  # Keep lifecycle actions manual and confirmation-gated. Do not enable
  # push, schedule, or workflow_run triggers without a teardown review:
  # workflow_run:
  #   workflows: ["CI"]
  #   types: [completed]
