#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  bootstrap-backend-parameters --environment ENV --from-env-file PATH [options]
  bootstrap-backend-parameters --environment ENV --clear-parameter NAME [options]

The env file is read locally and values are never printed. Dry-run is the
default; --apply writes parameters beneath the configured parameter path. The
clear-parameter mode removes one named parameter. Runtime values are
SecureString by default; repeat --non-secret NAME for explicitly non-secret
values. Existing parameter types are preserved unless --allow-type-change is
explicitly provided.
EOF
}

environment=""
environment_file=""
application_name="${APPLICATION_NAME:-application}"
ssm_parameter_path="${SSM_PARAMETER_PATH:-}"
clear_parameter=""
non_secret_parameters=()
allow_type_change=false
apply=false

while (($# > 0)); do
  case "$1" in
    --environment)
      (($# >= 2)) || { echo "--environment requires a value" >&2; exit 1; }
      shift; environment="$1"
      ;;
    --from-env-file)
      (($# >= 2)) || { echo "--from-env-file requires a path" >&2; exit 1; }
      shift; environment_file="$1"
      ;;
    --application-name)
      (($# >= 2)) || { echo "--application-name requires a value" >&2; exit 1; }
      shift; application_name="$1"
      ;;
    --ssm-parameter-path)
      (($# >= 2)) || { echo "$1 requires a path" >&2; exit 1; }
      shift; ssm_parameter_path="$1"
      ;;
    --clear-parameter)
      (($# >= 2)) || { echo "--clear-parameter requires a name" >&2; exit 1; }
      shift; clear_parameter="$1"
      ;;
    --non-secret)
      (($# >= 2)) || { echo "--non-secret requires a parameter name" >&2; exit 1; }
      shift; non_secret_parameters+=("$1")
      ;;
    --allow-type-change) allow_type_change=true ;;
    --apply) apply=true ;;
    --help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
  shift
done

[[ "$environment" =~ ^(staging|production)$ ]] || {
  echo "--environment must be staging or production" >&2
  exit 1
}
if [[ -n "$clear_parameter" && -n "$environment_file" ]]; then
  echo "--clear-parameter cannot be combined with --from-env-file" >&2
  exit 1
fi

if [[ -z "$clear_parameter" && ! -r "$environment_file" ]]; then
  echo "environment file is not readable: $environment_file" >&2
  exit 1
fi

aws_region="${AWS_REGION:?AWS_REGION is required}"
ssm_parameter_path="${ssm_parameter_path:-/$application_name/$environment}"

[[ "$application_name" =~ ^[a-z][a-z0-9-]{1,32}$ ]] || {
  echo "application name must be 2-33 lowercase letters, numbers, or hyphens" >&2
  exit 1
}
[[ "$ssm_parameter_path" =~ ^/[^/].*[^/]$ ]] || {
  echo "parameter path must start and end with a non-slash path component" >&2
  exit 1
}

if [[ -n "$clear_parameter" ]]; then
  [[ "$clear_parameter" =~ ^[A-Z][A-Z0-9_]*$ ]] || {
    echo "parameter name must be an uppercase environment variable name" >&2
    exit 1
  }
  echo "$ssm_parameter_path/$clear_parameter (delete if present)"
  if [[ "$apply" == true ]]; then
    aws ssm delete-parameter --region "$aws_region" \
      --name "$ssm_parameter_path/$clear_parameter" --no-cli-pager >/dev/null 2>&1 || true
    echo "Cleared $ssm_parameter_path/$clear_parameter"
  else
    echo "Dry run only. Re-run with --apply to clear the parameter."
  fi
  exit 0
fi

allowed_parameter() {
  [[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]]
}

parameter_type() {
  local parameter_name="$1"
  for non_secret_parameter in "${non_secret_parameters[@]}"; do
    [[ "$parameter_name" == "$non_secret_parameter" ]] && {
      printf 'String'
      return
    }
  done
  printf 'SecureString'
}

declare -A seen_parameters=()
parameters=()
while IFS= read -r line || [[ -n "$line" ]]; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  [[ "$line" == *=* ]] || {
    echo "invalid environment line" >&2
    exit 1
  }
  name="${line%%=*}"
  value="${line#*=}"
  allowed_parameter "$name" || {
    echo "unsupported runtime parameter: $name" >&2
    exit 1
  }
  [[ -n "$value" ]] || {
    echo "runtime parameter values cannot be empty: $name" >&2
    exit 1
  }
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || {
    echo "runtime parameters must be single-line values" >&2
    exit 1
  }
  [[ ! -v "seen_parameters[$name]" ]] || {
    echo "duplicate runtime parameter: $name" >&2
    exit 1
  }
  seen_parameters["$name"]=1
  parameters+=("$name"$'\t'"$value")
done <"$environment_file"

for non_secret_parameter in "${non_secret_parameters[@]}"; do
  allowed_parameter "$non_secret_parameter" || {
    echo "unsupported non-secret parameter: $non_secret_parameter" >&2
    exit 1
  }
  [[ -v "seen_parameters[$non_secret_parameter]" ]] || {
    echo "non-secret parameter is not present in the environment file: $non_secret_parameter" >&2
    exit 1
  }
done

[[ "${#parameters[@]}" -gt 0 ]] || {
  echo "no runtime parameters found" >&2
  exit 1
}

for parameter in "${parameters[@]}"; do
  name="${parameter%%$'\t'*}"
  type="$(parameter_type "$name")"
  echo "$ssm_parameter_path/$name ($type)"
  if [[ "$apply" == true ]]; then
    value="${parameter#*$'\t'}"
    existing_type=""
    if existing_type="$(aws ssm get-parameter --region "$aws_region" \
      --name "$ssm_parameter_path/$name" --query 'Parameter.Type' --output text \
      --no-cli-pager 2>/dev/null)"; then
      if [[ -n "$existing_type" && "$existing_type" != 'None' && "$existing_type" != "$type" && "$allow_type_change" != true ]]; then
        echo "existing parameter type for $ssm_parameter_path/$name is $existing_type; pass --allow-type-change to migrate it" >&2
        exit 1
      fi
    fi
    aws ssm put-parameter --region "$aws_region" \
      --name "$ssm_parameter_path/$name" --type "$type" --value "$value" \
      --overwrite --no-cli-pager >/dev/null
  fi
done

if [[ "$apply" != true ]]; then
  echo "Dry run only. Re-run with --apply to write these parameters."
else
  echo "Updated runtime parameters under $ssm_parameter_path"
fi
