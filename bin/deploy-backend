#!/usr/bin/env bash
set -euo pipefail

script_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat >&2 <<'EOF'
Usage: deploy-backend [--apply] [--release-id ID] [--activate-existing] [--release-file DEST=PATH]

Required environment variables: APPLICATION_NAME, ENVIRONMENT, AWS_REGION,
ARTIFACT_BUCKET, API_URL, COMPOSE_FILE, CADDY_FILE
Optional environment variables: INSTANCE_ID, BUILD_CONTEXT, DOCKERFILE,
FRONTEND_URL, FRONTEND_ORIGIN, APPLICATION_API_TOKEN, SUPPLEMENTAL_RELEASE_FILES
EOF
}

apply=false
activate_existing=false
release_id="${RELEASE_ID:-}"
supplemental_files=()

while (($# > 0)); do
  case "$1" in
    --apply) apply=true ;;
    --activate-existing) activate_existing=true ;;
    --release-id) shift; release_id="${1:-}" ;;
    --release-file) shift; supplemental_files+=("${1:-}") ;;
    --help) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
  shift
done

environment="${ENVIRONMENT:?ENVIRONMENT is required}"
application_name="${APPLICATION_NAME:?APPLICATION_NAME is required}"
aws_region="${AWS_REGION:?AWS_REGION is required}"
artifact_bucket="${ARTIFACT_BUCKET:?ARTIFACT_BUCKET is required}"
api_url="${API_URL:?API_URL is required}"
compose_file="${COMPOSE_FILE:?COMPOSE_FILE is required}"
caddy_file="${CADDY_FILE:?CADDY_FILE is required}"
build_context="${BUILD_CONTEXT:-.}"
dockerfile="${DOCKERFILE:-Dockerfile}"

if [[ -n "${SUPPLEMENTAL_RELEASE_FILES:-}" ]]; then
  IFS=',' read -ra configured_supplemental_files <<<"$SUPPLEMENTAL_RELEASE_FILES"
  supplemental_files+=("${configured_supplemental_files[@]}")
fi

[[ "$application_name" =~ ^[a-z][a-z0-9-]{1,32}$ ]] || {
  echo "APPLICATION_NAME must be 2-33 lowercase letters, numbers, or hyphens and start with a letter" >&2
  exit 1
}

case "$environment" in
  staging|production) ;;
  *) echo "ENVIRONMENT must be staging or production" >&2; exit 1 ;;
esac

if [[ -z "$release_id" ]]; then
  release_id="${GITHUB_SHA:-$(git rev-parse HEAD)}"
fi
[[ "$release_id" =~ ^[0-9a-f]{7,64}$ ]] || {
  echo "release ID must be a hexadecimal commit identifier" >&2
  exit 1
}

if [[ "$activate_existing" == true && "$apply" != true ]]; then
  echo "--activate-existing requires --apply" >&2
  exit 1
fi

required_files=(
  "$dockerfile"
  "$compose_file"
  "$caddy_file"
)
for required_file in "${required_files[@]}"; do
  [[ -f "$required_file" ]] || {
    echo "missing release file: $required_file" >&2
    exit 1
  }
done

supplemental_artifacts=()
supplemental_sources=()
declare -A seen_supplemental_artifacts=()
for supplemental_file in "${supplemental_files[@]}"; do
  [[ "$supplemental_file" == *=* ]] || {
    echo "supplemental release file must use DEST=PATH: $supplemental_file" >&2
    exit 1
  }
  artifact_name="${supplemental_file%%=*}"
  artifact_source="${supplemental_file#*=}"
  [[ "$artifact_name" =~ ^[A-Za-z0-9._/-]+$ && "$artifact_name" != /* && "$artifact_name" != *'..'* && "$artifact_name" != */ ]] || {
    echo "invalid supplemental release artifact path: $artifact_name" >&2
    exit 1
  }
  case "$artifact_name" in
    image.tar.zst|compose.yaml|Caddyfile|manifest.json)
      echo "supplemental artifact conflicts with a reserved release artifact: $artifact_name" >&2
      exit 1 ;;
  esac
  [[ ! -v "seen_supplemental_artifacts[$artifact_name]" ]] || {
    echo "duplicate supplemental release artifact path: $artifact_name" >&2
    exit 1
  }
  seen_supplemental_artifacts["$artifact_name"]=1
  [[ -r "$artifact_source" ]] || {
    echo "missing supplemental release file: $artifact_source" >&2
    exit 1
  }
  supplemental_artifacts+=("$artifact_name")
  supplemental_sources+=("$artifact_source")
done

release_prefix="releases/$release_id"
release_artifacts=(image.tar.zst compose.yaml Caddyfile manifest.json)
artifact_payloads=(image.tar.zst compose.yaml Caddyfile)
expected_artifact_count=$((4 + ${#supplemental_artifacts[@]}))
echo "Backend release: $release_id"
echo "Environment: $environment"
echo "Region: $aws_region"
echo "Artifact bucket: $artifact_bucket"

if [[ "$apply" != true ]]; then
  echo "Dry run only. Re-run with --apply to build, upload, and activate the release."
  exit 0
fi

temporary_directory="$(mktemp -d)"
trap 'rm -rf "$temporary_directory"' EXIT

published_artifacts=0
for artifact in "${release_artifacts[@]}"; do
  if aws s3api head-object --region "$aws_region" --bucket "$artifact_bucket" \
    --key "$release_prefix/$artifact" >/dev/null 2>&1; then
    published_artifacts=$((published_artifacts + 1))
  fi
done

case "$published_artifacts" in
  0)
    if [[ "$activate_existing" == true ]]; then
      echo "cannot activate release that is not published: $release_prefix" >&2
      exit 1
    fi
    ;;
  "$expected_artifact_count")
    activate_existing=true
    echo "Immutable release already published; reusing: s3://$artifact_bucket/$release_prefix/"
    ;;
  *)
    echo "release already exists or is partially uploaded: $release_prefix" >&2
    exit 1
    ;;
esac

if [[ "$activate_existing" != true ]]; then
  image_name="$application_name:$release_id"
  docker buildx build --platform linux/arm64 --load --tag "$image_name" --file "$dockerfile" "$build_context"
  docker save "$image_name" | zstd -T0 -19 >"$temporary_directory/image.tar.zst"
  cp "$compose_file" "$temporary_directory/compose.yaml"
  cp "$caddy_file" "$temporary_directory/Caddyfile"
  for index in "${!supplemental_artifacts[@]}"; do
    artifact_name="${supplemental_artifacts[$index]}"
    install -d "$(dirname "$temporary_directory/$artifact_name")"
    cp "${supplemental_sources[$index]}" "$temporary_directory/$artifact_name"
    artifact_payloads+=("$artifact_name")
  done

  checksums="$(cd "$temporary_directory" && sha256sum "${artifact_payloads[@]}" | jq -Rn '[inputs | capture("^(?<checksum>[0-9a-f]+)  (?<path>.+)$") | {(.path): .checksum}] | add')"
  supplemental_json="$(printf '%s\n' "${supplemental_artifacts[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  jq -n --arg application "$application_name" --arg environment "$environment" \
    --arg release_id "$release_id" --arg architecture arm64 \
    --argjson checksums "$checksums" --argjson supplemental "$supplemental_json" \
    '{application: $application, environment: $environment, release_id: $release_id, architecture: $architecture, checksums: $checksums, supplemental_artifacts: $supplemental}' \
    >"$temporary_directory/manifest.json"

  for artifact in "${release_artifacts[@]}"; do
    aws s3 cp --region "$aws_region" --only-show-errors "$temporary_directory/$artifact" "s3://$artifact_bucket/$release_prefix/$artifact"
  done
  echo "Uploaded immutable release: s3://$artifact_bucket/$release_prefix/"
fi

if [[ -n "${INSTANCE_ID:-}" ]]; then
  instance_id="$INSTANCE_ID"
else
  mapfile -t instance_ids < <(aws ec2 describe-instances \
    --region "$aws_region" \
    --filters "Name=tag:Application,Values=$application_name" \
      "Name=tag:Environment,Values=$environment" \
      "Name=instance-state-name,Values=running" \
    --query 'Reservations[].Instances[].InstanceId' --output text | tr '\t' '\n' | sed '/^$/d')
  [[ "${#instance_ids[@]}" -eq 1 ]] || {
    echo "expected exactly one running $environment $application_name instance; found ${#instance_ids[@]}" >&2
    exit 1
  }
  instance_id="${instance_ids[0]}"
fi

command_parameters="$temporary_directory/ssm-command.json"
jq -n --arg command "sudo /usr/local/bin/${application_name}-activate-release '$release_id'" \
  '{commands: [$command]}' >"$command_parameters"
command_id="$(aws ssm send-command --region "$aws_region" \
  --document-name AWS-RunShellScript --instance-ids "$instance_id" \
  --parameters "file://$command_parameters" \
  --query 'Command.CommandId' --output text)"

print_ssm_failure_output() {
  local output
  output="$(aws ssm get-command-invocation --region "$aws_region" \
    --command-id "$command_id" --instance-id "$instance_id" \
    --query '[StandardOutputContent,StandardErrorContent]' --output text 2>/dev/null || true)"
  if [[ -n "$output" && "$output" != $'None\tNone' ]]; then
    echo 'remote SSM command output:' >&2
    printf '%s\n' "$output" >&2
  fi
}

for attempt in $(seq 1 60); do
  status="$(aws ssm get-command-invocation --region "$aws_region" \
    --command-id "$command_id" --instance-id "$instance_id" \
    --query 'Status' --output text 2>/dev/null || true)"
  case "$status" in
    Success)
      echo "Activated release $release_id on $instance_id"
      break
      ;;
    Failed|Cancelled|TimedOut|Cancelling)
      print_ssm_failure_output
      echo "release activation failed with SSM status: $status" >&2
      exit 1
      ;;
    *)
      if [[ "$attempt" -eq 60 ]]; then
        print_ssm_failure_output
        echo "release activation did not complete within the timeout" >&2
        exit 1
      fi
      sleep 5
      ;;
  esac
done

api_headers=()
if [[ -n "${APPLICATION_API_TOKEN:-}" ]]; then
  api_headers=(-H "Authorization: Bearer $APPLICATION_API_TOKEN")
fi

for endpoint in healthz readyz; do
  for attempt in $(seq 1 24); do
    health_body="$temporary_directory/$endpoint.json"
    if curl --silent --show-error --fail --max-time 20 \
      "${api_headers[@]}" -o "$health_body" "${api_url%/}/$endpoint" &&
      [[ "$endpoint" != healthz || "$(jq -r '.status // empty' "$health_body")" == "ok" ]]; then
      break
    fi
    if [[ "$attempt" -eq 24 ]]; then
      echo "API /$endpoint did not become healthy" >&2
      exit 1
    fi
    sleep 10
  done
done

if [[ -n "${FRONTEND_URL:-}" ]]; then
  export FRONTEND_URL="${FRONTEND_URL%/}"
  export API_URL="$api_url"
  export FRONTEND_ORIGIN="${FRONTEND_ORIGIN:-$FRONTEND_URL}"
  bash "$script_directory/frontend-live-smoke"
fi

echo "Backend release verification passed: $release_id"
